import NanoP4Spec
import P4SpecTec.Lang.Il.Json
import P4SpecTec.Util.Yojson

/-!
Quote an exported Nano-P4 program as a typed term of the generated model, for whole-program
statements. The export is decoded exactly as the session replay decodes it and printed through
`Repr` instances derived here for every generated data type, with byte texts printed as
`ByteText.ofString` literals. `--check` compares the committed module with a fresh quotation;
`check-consumer` separately compares the compiled term with the decoded export.
-/

namespace P4SpecTec.Tools.QuoteProgram

open Lean Elab Command

/-- The generated data types that the constant `c` mentions, seeing through abbreviations. -/
partial def dataTypes (env : Environment) (c : Name) (seen : NameSet := {}) : NameSet :=
  if seen.contains c || c.getRoot != `NanoP4Spec then {} else
  match env.find? c with
  | some (.inductInfo _) => NameSet.empty.insert c
  | some (.defnInfo d) =>
    d.value.getUsedConstants.foldl (init := {}) fun acc n =>
      acc.append (dataTypes env n (seen.insert c))
  | _ => {}

/-- Derive `Repr` for every data type of the generated model, dependencies first. -/
elab "derive_generated_repr" : command => do
  let env ← getEnv
  -- mutual groups of data types, keyed by their first member
  let mut groups : Array (Array Name) := #[]
  let mut seen : NameSet := {}
  for modName in env.header.moduleNames, data in env.header.moduleData do
    unless modName.getRoot == `NanoP4Spec && !(`NanoP4Spec.Refinement).isPrefixOf modName do
      continue
    for name in data.constNames do
      let some (.inductInfo info) := env.find? name | continue
      if seen.contains name || isClass env name then continue
      for n in info.all do seen := seen.insert n
      let isData ← liftTermElabM <| Meta.forallTelescopeReducing info.type fun _ body =>
        return !body.isProp
      if isData then groups := groups.push info.all.toArray
  let groupOf (n : Name) : Option Nat := groups.findIdx? (·.contains n)
  let deps : Array (Array Nat) := groups.mapIdx fun k members => Id.run do
    let mut out := #[]
    for m in members do
      let some (.inductInfo info) := env.find? m | continue
      for ctor in info.ctors do
        let some ci := env.find? ctor | continue
        for n in ci.type.getUsedConstants do
          for d in dataTypes env n do
            if let some g := groupOf d then
              if g != k && !out.contains g then out := out.push g
    return out
  -- derive each group after the groups its constructors mention
  let mut done : Array Bool := groups.map fun _ => false
  let mut progress := true
  while progress do
    progress := false
    for k in [0:groups.size] do
      if done[k]! || !(deps[k]!.all (done[·]!)) then continue
      let ids := groups[k]!.map mkIdent
      elabCommand (← `(command| deriving instance Repr for $ids,*))
      done := done.set! k true
      progress := true
  unless done.all id do throwError "cyclic generated data types"

/-- Byte texts print as the literals the generator writes. -/
instance (priority := high) reprByteText : Repr ByteText where
  reprPrec text _ := match text.toString? with
    | some s => .text s!"(P4SpecTec.ByteText.ofString {repr s})"
    | none => .text s!"(P4SpecTec.ByteText.ofBytes ⟨{repr text.bytes.toList.toArray}⟩)"

/-- Extern payloads cannot occur in a parsed program; printing one fails elaboration. -/
instance reprExternValue : Repr Prelude.ExternValue where
  reprPrec _ _ := .text "(unsupported_extern_value)"

derive_generated_repr

/-- Decoder fuel; exhaustion is an error, never a smaller program. -/
def fuel : Nat := 1000000

/-- The generated module for `program`, decoded from `exportPath`. -/
def render (exportPath : String) (ns : Name) (program : NanoP4Spec.program) : String :=
  let term := (Std.Format.nest 2 (repr program)).pretty 98
  let header := "-- GENERATED by nano-program-quote; do not edit, regenerate.\n" ++
    s!"-- source: {exportPath}\n"
  header ++ "import NanoP4Spec\n\n" ++
  "/-!\n" ++
  "An exported Nano-P4 program as a typed term of the generated model, decoded as the session\n" ++
  "replay decodes it. `check-consumer` compares the compiled term with the decoded export.\n" ++
  "-/\n\n" ++
  s!"namespace {ns}\n\n" ++
  "set_option maxRecDepth 10000 in\n" ++
  "/-- The exported program, decoded into the generated Nano-P4 model. -/\n" ++
  s!"def program : NanoP4Spec.program :=\n  {term}\n\n" ++
  s!"end {ns}\n"

/-- Quote the program; `--update` writes the module and `--check` compares it. -/
def run (exportPath : String) (ns : Name) (output : String) (mode : String) : IO UInt32 := do
  let bytes ← IO.FS.readBinFile exportPath
  let value ← IO.ofExcept (Util.Yojson.parseBytes bytes >>= Lang.Il.Json.value)
  let some program := NanoP4Spec.program.ofValue fuel value
    | IO.eprintln s!"[quote-program] {exportPath} does not decode into the generated model"
      return 1
  let text := render exportPath ns program
  if let some line := (text.splitOn "\n").find? (·.length > 100) then
    IO.eprintln s!"[quote-program] rendered line over 100 characters: {line}"
    return 1
  match mode with
  | "--update" =>
    IO.FS.writeFile output text
    IO.println s!"[quote-program] wrote {output}"
    return 0
  | "--check" =>
    let current ← IO.FS.readFile output
    if current == text then
      IO.println s!"[quote-program] {output} is current"
      return 0
    IO.eprintln s!"[quote-program] {output} is stale; regenerate with --update"
    return 1
  | _ =>
    IO.eprintln s!"[quote-program] unknown mode {mode}"
    return 1

end P4SpecTec.Tools.QuoteProgram

/-- `nano-program-quote EXPORT NAMESPACE OUTPUT (--update | --check)`. -/
def main (args : List String) : IO UInt32 :=
  match args with
  | [exportPath, ns, output, mode] =>
    P4SpecTec.Tools.QuoteProgram.run exportPath ns.toName output mode
  | _ => do
    IO.eprintln "usage: nano-program-quote EXPORT NAMESPACE OUTPUT (--update | --check)"
    return 1
