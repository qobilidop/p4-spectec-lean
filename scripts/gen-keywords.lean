import Lean

/-!
Print `P4SpecTec/Codegen/Keywords.lean`: the identifier-like tokens of
Lean's own token table, so the code generator never hand-maintains the
list of names that need `«»` quoting (decisions: "Build and test").
Run by `scripts/gen-keywords.sh` as `lake env lean scripts/gen-keywords.lean`,
whose `#eval` prints the module; CI checks the committed file is current.
-/

open Lean

/-- The identifier-like tokens of this file's environment, which imports
all of `Lean`, sorted. -/
def keywords : CoreM (Array String) := do
  let tt := Lean.Parser.getTokenTable (← getEnv)
  let ks := tt.values.filter fun k => k.length > 0 && (k.front.isAlpha || k.front == '_')
  pure (ks.qsort (· < ·))

/-- Print the module. -/
def printModule : CoreM Unit := do
  let ks ← keywords
  let mut out := ""
  out := out ++ "-- GENERATED by scripts/gen-keywords.sh from Lean's token table; do not edit.\n"
  out := out ++ "/-!\nThe identifier-like tokens of the Lean toolchain named in `lean-toolchain`,\n"
  out := out ++ "extracted from the parser's token table with all of `Lean` imported. A\n"
  out := out ++ "generated name equal to one of these is quoted with `«»`.\n-/\n\n"
  out := out ++ "namespace P4SpecTec.Codegen\n\n"
  out := out ++ "/-- Lean's identifier-like tokens. -/\ndef keywords : List String := [\n"
  for k in ks do
    out := out ++ s!"  {repr k},\n"
  out := out ++ "]\n\nend P4SpecTec.Codegen\n"
  IO.print out

#eval printModule
