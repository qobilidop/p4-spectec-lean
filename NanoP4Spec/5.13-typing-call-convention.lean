def ParserState_ok.run
        (p0 : NanoP4Spec.typingContext)
        (p1 : List NanoP4Spec.nameIR)
        (p2 : NanoP4Spec.parserState)
    : Option (Except Fail Unit) :=
  ExceptT.run
    (do
       have TC_0 := p0
       have «nameIR_state*» := p1
       let .STATE_lbrace_rbrace name statementList transitionStatement := p2
       (do
          let tmp_0 ← ExceptT.mk (NanoP4Spec.«$enter_t» TC_0)
          have TC_1 := tmp_0
          let tmp_1 ← ExceptT.mk (NanoP4Spec.«$flatten_statementList» statementList)
          have «statement*» := tmp_1
          let tmp_2 ← ExceptT.mk (NanoP4Spec.Statements_ok.run TC_1 «statement*»)
          have TC_2 := tmp_2
          let _ ←
              ExceptT.mk
                (NanoP4Spec.ParserTransition_ok.run TC_2 «nameIR_state*» transitionStatement)
          let tmp_3 ← ExceptT.mk (NanoP4Spec.«$exit_t» TC_2)
          have TC_3 := tmp_3
          pure ()))

inductive ParserState_ok : NanoP4Spec.typingContext →
  (List NanoP4Spec.nameIR) →
  NanoP4Spec.parserState →
  Prop where
  | rule0
      {TC_0 : NanoP4Spec.typingContext}
      {«nameIR_state*» : List NanoP4Spec.nameIR}
      {name : NanoP4Spec.name}
      {statementList : NanoP4Spec.statementList}
      {transitionStatement : NanoP4Spec.transitionStatement}
      {TC_1 : NanoP4Spec.typingContext}
      {«statement*» : List NanoP4Spec.statement}
      {TC_2 : NanoP4Spec.typingContext}
      {TC_3 : NanoP4Spec.typingContext} :
        (NanoP4Spec.«$enter_t» TC_0 = some (.ok TC_1)) →
        (NanoP4Spec.«$flatten_statementList» statementList = some (.ok «statement*»)) →
        (NanoP4Spec.Statements_ok TC_1 «statement*» TC_2) →
        (NanoP4Spec.ParserTransition_ok TC_2 «nameIR_state*» transitionStatement) →
        (NanoP4Spec.«$exit_t» TC_2 = some (.ok TC_3)) →
        NanoP4Spec.ParserState_ok
          TC_0
          «nameIR_state*»
          (NanoP4Spec.parserState.STATE_lbrace_rbrace name statementList transitionStatement)

theorem ParserState_ok.run_sound
    (p0 : NanoP4Spec.typingContext)
    (p1 : List NanoP4Spec.nameIR)
    (p2 : NanoP4Spec.parserState) :
    NanoP4Spec.ParserState_ok.run p0 p1 p2 = some (.ok ()) → NanoP4Spec.ParserState_ok p0 p1 p2 :=
  by run_sound

#audit_axioms NanoP4Spec.ParserState_ok.run_sound

