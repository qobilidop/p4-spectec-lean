def Program_ok.run (p0 : NanoP4Spec.program) : Option (Except Fail NanoP4Spec.typingContext) :=
  ExceptT.run
    (do
       have program := p0
       (do
          let tmp_0 ← ExceptT.mk (NanoP4Spec.«$flatten_program» program)
          have «declaration*» := tmp_0
          let tmp_1 ← ExceptT.mk NanoP4Spec.«$empty_typingContext»
          have TC := tmp_1
          let tmp_2 ← ExceptT.mk (NanoP4Spec.Decls_ok.run TC «declaration*»)
          have TC' := tmp_2
          pure TC'))

inductive Program_ok : NanoP4Spec.program → NanoP4Spec.typingContext → Prop where
  | rule0
      {program : NanoP4Spec.program}
      {«declaration*» : List NanoP4Spec.declaration}
      {TC : NanoP4Spec.typingContext}
      {TC' : NanoP4Spec.typingContext} :
        (NanoP4Spec.«$flatten_program» program = some (.ok «declaration*»)) →
        (NanoP4Spec.«$empty_typingContext» = some (.ok TC)) →
        (NanoP4Spec.Decls_ok TC «declaration*» TC') →
        NanoP4Spec.Program_ok program TC'

theorem Program_ok.run_sound
    (p0 : NanoP4Spec.program)
    (o : NanoP4Spec.typingContext) :
    NanoP4Spec.Program_ok.run p0 = some (.ok o) → NanoP4Spec.Program_ok p0 o :=
  by run_sound

