def Decls_ok.run (p0 : NanoP4Spec.typingContext) (p1 : List NanoP4Spec.declaration)
    : Option (Except Fail NanoP4Spec.typingContext) :=
  ExceptT.run
    (do
       have TC_0 := p0
       have «declaration*» := p1
       (do
          let _ ← Eval.check («declaration*» == ([] : List NanoP4Spec.declaration))
          pure TC_0) <|>
       (do
          have «declaration'*» := «declaration*»
          let _ ← Eval.check (!(List.isEmpty «declaration'*»))
          let declaration_h :: «declaration_t*» := «declaration'*» | throw Fail.err
          let tmp_0 ← ExceptT.mk (NanoP4Spec.Decl_ok.run TC_0 declaration_h)
          have TC_1 := tmp_0
          let tmp_1 ← ExceptT.mk (NanoP4Spec.Decls_ok.run TC_1 «declaration_t*»)
          have TC_2 := tmp_1
          pure TC_2))
  partial_fixpoint

inductive Decls_ok : NanoP4Spec.typingContext →
  (List NanoP4Spec.declaration) →
  NanoP4Spec.typingContext →
  Prop where
  | nil {TC_0 : NanoP4Spec.typingContext} {«declaration*» : List NanoP4Spec.declaration} :
        ((«declaration*» == ([] : List NanoP4Spec.declaration) : Bool) = true) →
        NanoP4Spec.Decls_ok TC_0 «declaration*» TC_0
  | cons
      {TC_0 : NanoP4Spec.typingContext}
      {declaration_h : NanoP4Spec.declaration}
      {«declaration_t*» : List NanoP4Spec.declaration}
      {TC_1 : NanoP4Spec.typingContext}
      {TC_2 : NanoP4Spec.typingContext} :
        ((!(List.isEmpty (declaration_h :: «declaration_t*»)) : Bool) = true) →
        (NanoP4Spec.Decl_ok TC_0 declaration_h TC_1) →
        (NanoP4Spec.Decls_ok TC_1 «declaration_t*» TC_2) →
        NanoP4Spec.Decls_ok TC_0 (declaration_h :: «declaration_t*») TC_2

theorem Decls_ok.run_sound_group :
    (∀
         (p0 : NanoP4Spec.typingContext)
         (p1 : List NanoP4Spec.declaration)
         (r : Except Fail NanoP4Spec.typingContext),
         NanoP4Spec.Decls_ok.run p0 p1 = some r →
         ∀ (o : NanoP4Spec.typingContext), r = .ok o →
         NanoP4Spec.Decls_ok p0 p1 o) := by
  run_sound_group NanoP4Spec.Decls_ok.run.partial_correctness

#audit_axioms NanoP4Spec.Decls_ok.run_sound_group

theorem Decls_ok.run_sound
    (p0 : NanoP4Spec.typingContext)
    (p1 : List NanoP4Spec.declaration)
    (o : NanoP4Spec.typingContext) :
    NanoP4Spec.Decls_ok.run p0 p1 = some (.ok o) → NanoP4Spec.Decls_ok p0 p1 o :=
  fun h => NanoP4Spec.Decls_ok.run_sound_group p0 p1 _ h o rfl

#audit_axioms NanoP4Spec.Decls_ok.run_sound

