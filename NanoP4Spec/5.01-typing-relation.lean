def TableKey_ok.run (p0 : NanoP4Spec.typingContext) (p1 : NanoP4Spec.tableKey)
    : Option (Except Fail NanoP4Spec.matchKey) :=
  ExceptT.run
    (do
       have TC := p0
       let .lbrace_colon_semi_rbrace expression name_matchKind := p1
       (do
          let tmp_0 ← ExceptT.mk (NanoP4Spec.Expr_ok.run NanoP4Spec.scope.BLOCK TC expression)
          have typeIR := tmp_0
          let tmp_1 ← ExceptT.mk (NanoP4Spec.«$id» name_matchKind)
          have id := tmp_1
          let tmp_2 ← ExceptT.mk (NanoP4Spec.«$find_var_t» NanoP4Spec.scope.GLOBAL TC id)
          let _ ← Eval.check ((NanoP4Spec.varTypeIR.mk
              NanoP4Spec.direction._EMPTY
              (NanoP4Spec.baseTypeIR.to_typeIR NanoP4Spec.baseTypeIR.MATCH_KIND)) ==
           tmp_2)
          let tmp_3 ← ExceptT.mk (NanoP4Spec.«$print_» (τX := NanoP4Spec.expression) expression)
          let tmp_4 ← ExceptT.mk (NanoP4Spec.«$strip_all_whitespace» tmp_3)
          have nameIR := tmp_4
          have matchKey := NanoP4Spec.matchKey.colon typeIR nameIR
          pure matchKey))

inductive TableKey_ok : NanoP4Spec.typingContext →
  NanoP4Spec.tableKey →
  NanoP4Spec.matchKey →
  Prop where
  | rule0
      {TC : NanoP4Spec.typingContext}
      {expression : NanoP4Spec.expression}
      {name_matchKind : NanoP4Spec.name}
      {typeIR : NanoP4Spec.typeIR}
      {id : String}
      {tmp_2 : NanoP4Spec.varTypeIR}
      {tmp_3 : String}
      {nameIR : String} :
        (NanoP4Spec.Expr_ok NanoP4Spec.scope.BLOCK TC expression typeIR) →
        (NanoP4Spec.«$id» name_matchKind = some (.ok id)) →
        (NanoP4Spec.«$find_var_t» NanoP4Spec.scope.GLOBAL TC id = some (.ok tmp_2)) →
        (((NanoP4Spec.varTypeIR.mk
               NanoP4Spec.direction._EMPTY
               (NanoP4Spec.baseTypeIR.to_typeIR NanoP4Spec.baseTypeIR.MATCH_KIND)) ==
            tmp_2 : Bool) =
           true) →
        (NanoP4Spec.«$print_» (τX := NanoP4Spec.expression) expression = some (.ok tmp_3)) →
        (NanoP4Spec.«$strip_all_whitespace» tmp_3 = some (.ok nameIR)) →
        NanoP4Spec.TableKey_ok
          TC
          (NanoP4Spec.tableKey.lbrace_colon_semi_rbrace expression name_matchKind)
          (NanoP4Spec.matchKey.colon typeIR nameIR)

theorem TableKey_ok.run_sound
    (p0 : NanoP4Spec.typingContext)
    (p1 : NanoP4Spec.tableKey)
    (o : NanoP4Spec.matchKey) :
    NanoP4Spec.TableKey_ok.run p0 p1 = some (.ok o) → NanoP4Spec.TableKey_ok p0 p1 o :=
  by run_sound

#audit_axioms NanoP4Spec.TableKey_ok.run_sound

