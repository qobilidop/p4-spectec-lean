def Copy_out_arg.run
        (p0 : NanoP4Spec.scope)
        (p1 : NanoP4Spec.evalContext)
        (p2 : NanoP4Spec.parameterIR)
        (p3 : NanoP4Spec.scope)
        (p4 : NanoP4Spec.evalContext)
        (p5 : Option NanoP4Spec.lvalue)
    : Option (Except Fail NanoP4Spec.evalContext) :=
  ExceptT.run
    (do
       have scope_caller := p0
       have EC := p1
       let .mk direction typeIR' nameIR' := p2
       have scope_callee := p3
       have EC_callee := p4
       have lvalue'? := p5
       (do
          have EC_caller := EC
          have _typeIR := typeIR'
          have _nameIR := nameIR'
          let _ ← Eval.check (lvalue'? == (none : Option NanoP4Spec.lvalue))
          let _ ← Eval.check ((direction == NanoP4Spec.direction.IN) ||
           (direction == NanoP4Spec.direction._EMPTY))
          pure EC_caller) <|>
       (do
          have EC_caller_0 := EC
          have typeIR := typeIR'
          have nameIR := nameIR'
          have lvalue''? := lvalue'?
          let _ ← Eval.check (Option.isSome lvalue''?)
          let some lvalue := lvalue''? | throw Fail.err
          let _ ← Eval.check ((direction == NanoP4Spec.direction.OUT) ||
           (direction == NanoP4Spec.direction.INOUT))
          let tmp_0 ← ExceptT.mk (NanoP4Spec.«$find_var_e» scope_callee EC_callee nameIR)
          have value := tmp_0
          let tmp_1 ← ExceptT.mk (NanoP4Spec.Lvalue_write.run scope_caller EC_caller_0 lvalue value)
          have EC_caller_1 := tmp_1
          pure EC_caller_1))

inductive Copy_out_arg : NanoP4Spec.scope →
  NanoP4Spec.evalContext →
  NanoP4Spec.parameterIR →
  NanoP4Spec.scope →
  NanoP4Spec.evalContext →
  (Option NanoP4Spec.lvalue) →
  NanoP4Spec.evalContext →
  Prop where
  | «directionless-in»
      {scope_caller : NanoP4Spec.scope}
      {EC_caller : NanoP4Spec.evalContext}
      {scope_callee : NanoP4Spec.scope}
      {EC_callee : NanoP4Spec.evalContext}
      {lvalue'? : Option NanoP4Spec.lvalue}
      {direction : NanoP4Spec.direction}
      {_typeIR : NanoP4Spec.typeIR}
      {_nameIR : NanoP4Spec.nameIR} :
        ((lvalue'? == (none : Option NanoP4Spec.lvalue) : Bool) = true) →
        (((direction == NanoP4Spec.direction.IN) ||
            (direction == NanoP4Spec.direction._EMPTY) : Bool) =
           true) →
        NanoP4Spec.Copy_out_arg
          scope_caller
          EC_caller
          (NanoP4Spec.parameterIR.mk direction _typeIR _nameIR)
          scope_callee
          EC_callee
          lvalue'?
          EC_caller
  | «out-inout»
      {scope_caller : NanoP4Spec.scope}
      {EC_caller_0 : NanoP4Spec.evalContext}
      {scope_callee : NanoP4Spec.scope}
      {EC_callee : NanoP4Spec.evalContext}
      {direction : NanoP4Spec.direction}
      {typeIR : NanoP4Spec.typeIR}
      {nameIR : NanoP4Spec.nameIR}
      {lvalue : NanoP4Spec.lvalue}
      {value : NanoP4Spec.value}
      {EC_caller_1 : NanoP4Spec.evalContext} :
        ((Option.isSome (some lvalue) : Bool) = true) →
        (((direction == NanoP4Spec.direction.OUT) ||
            (direction == NanoP4Spec.direction.INOUT) : Bool) =
           true) →
        (NanoP4Spec.«$find_var_e» scope_callee EC_callee nameIR = some (.ok value)) →
        (NanoP4Spec.Lvalue_write scope_caller EC_caller_0 lvalue value EC_caller_1) →
        NanoP4Spec.Copy_out_arg
          scope_caller
          EC_caller_0
          (NanoP4Spec.parameterIR.mk direction typeIR nameIR)
          scope_callee
          EC_callee
          (some lvalue)
          EC_caller_1

theorem Copy_out_arg.run_sound
    (p0 : NanoP4Spec.scope)
    (p1 : NanoP4Spec.evalContext)
    (p2 : NanoP4Spec.parameterIR)
    (p3 : NanoP4Spec.scope)
    (p4 : NanoP4Spec.evalContext)
    (p5 : Option NanoP4Spec.lvalue)
    (o : NanoP4Spec.evalContext) :
    NanoP4Spec.Copy_out_arg.run p0 p1 p2 p3 p4 p5 = some (.ok o) →
        NanoP4Spec.Copy_out_arg p0 p1 p2 p3 p4 p5 o :=
  by run_sound

#audit_axioms NanoP4Spec.Copy_out_arg.run_sound

