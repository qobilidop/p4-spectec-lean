inductive TableMatch_eval [Externs] : NanoP4Spec.evalContext →
  NanoP4Spec.value →
  (List NanoP4Spec.tableEntry) →
  NanoP4Spec.evalContext →
  Prop where
  | «no-match»
      {EC : NanoP4Spec.evalContext}
      {value_tableKey : NanoP4Spec.value}
      {«tableEntry*» : List NanoP4Spec.tableEntry}
      {tmp_0 : List (NanoP4Spec.expression × NanoP4Spec.tableActionReference)}
      {«value_entry*» : List NanoP4Spec.value}
      {tmp_3 : Option NanoP4Spec.tableActionReference} :
        (List.length «tableEntry*» = List.length tmp_0) →
        (List.length (List.map (·.1) tmp_0) = List.length «value_entry*») →
        (∀
           (expression_entry : NanoP4Spec.expression)
           (value_entry : NanoP4Spec.value),
           (expression_entry, value_entry) ∈ (List.zip (List.map (·.1) tmp_0) «value_entry*») →
           NanoP4Spec.Expr_eval NanoP4Spec.scope.BLOCK EC expression_entry value_entry) →
        (NanoP4Spec.«$match_entry_value»
             value_tableKey
             (List.map
                (fun ((tableActionReference_entry, value_entry) :
                      NanoP4Spec.tableActionReference × NanoP4Spec.value) =>
                   (tableActionReference_entry, value_entry))
                (List.zip (List.map (·.2) tmp_0) «value_entry*»)) =
           some (.ok tmp_3)) →
        (((none : Option NanoP4Spec.tableActionReference) == tmp_3 : Bool) = true) →
        NanoP4Spec.TableMatch_eval EC value_tableKey «tableEntry*» EC
  | «match-no-argumentList»
      {EC_0 : NanoP4Spec.evalContext}
      {value_tableKey : NanoP4Spec.value}
      {«tableEntry*» : List NanoP4Spec.tableEntry}
      {tmp_0 : List (NanoP4Spec.expression × NanoP4Spec.tableActionReference)}
      {«value_entry*» : List NanoP4Spec.value}
      {tableActionReference : NanoP4Spec.tableActionReference}
      {name : NanoP4Spec.name}
      {EC_1 : NanoP4Spec.evalContext} :
        (List.length «tableEntry*» = List.length tmp_0) →
        (List.length (List.map (·.1) tmp_0) = List.length «value_entry*») →
        (∀
           (expression_entry : NanoP4Spec.expression)
           (value_entry : NanoP4Spec.value),
           (expression_entry, value_entry) ∈ (List.zip (List.map (·.1) tmp_0) «value_entry*») →
           NanoP4Spec.Expr_eval NanoP4Spec.scope.BLOCK EC_0 expression_entry value_entry) →
        (NanoP4Spec.«$match_entry_value»
             value_tableKey
             (List.map
                (fun ((tableActionReference_entry, value_entry) :
                      NanoP4Spec.tableActionReference × NanoP4Spec.value) =>
                   (tableActionReference_entry, value_entry))
                (List.zip (List.map (·.2) tmp_0) «value_entry*»)) =
           some (.ok (some tableActionReference))) →
        ((Option.isSome (some tableActionReference) : Bool) = true) →
        ((NanoP4Spec.tableActionReference.is_nonTypeName tableActionReference : Bool) = true) →
        (NanoP4Spec.tableActionReference.of_nonTypeName tableActionReference = some name) →
        (NanoP4Spec.Statement_eval
           NanoP4Spec.scope.BLOCK
           EC_0
           (NanoP4Spec.callStatement.to_statement
              (NanoP4Spec.callStatement.lparen_rparen_semi
                 (NanoP4Spec.nonTypeName.to_lvalue name)
                 NanoP4Spec.argumentList._EMPTY))
           EC_1) →
        NanoP4Spec.TableMatch_eval EC_0 value_tableKey «tableEntry*» EC_1
  | «match-argumentList»
      {EC_0 : NanoP4Spec.evalContext}
      {value_tableKey : NanoP4Spec.value}
      {«tableEntry*» : List NanoP4Spec.tableEntry}
      {tmp_0 : List (NanoP4Spec.expression × NanoP4Spec.tableActionReference)}
      {«value_entry*» : List NanoP4Spec.value}
      {name : NanoP4Spec.name}
      {argumentList : NanoP4Spec.argumentList}
      {EC_1 : NanoP4Spec.evalContext} :
        (List.length «tableEntry*» = List.length tmp_0) →
        (List.length (List.map (·.1) tmp_0) = List.length «value_entry*») →
        (∀
           (expression_entry : NanoP4Spec.expression)
           (value_entry : NanoP4Spec.value),
           (expression_entry, value_entry) ∈ (List.zip (List.map (·.1) tmp_0) «value_entry*») →
           NanoP4Spec.Expr_eval NanoP4Spec.scope.BLOCK EC_0 expression_entry value_entry) →
        (NanoP4Spec.«$match_entry_value»
             value_tableKey
             (List.map
                (fun ((tableActionReference_entry, value_entry) :
                      NanoP4Spec.tableActionReference × NanoP4Spec.value) =>
                   (tableActionReference_entry, value_entry))
                (List.zip (List.map (·.2) tmp_0) «value_entry*»)) =
           some (.ok (some (NanoP4Spec.tableActionReference.lparen_rparen name argumentList)))) →
        ((Option.isSome
              (some (NanoP4Spec.tableActionReference.lparen_rparen name argumentList)) : Bool) =
           true) →
        (((match (NanoP4Spec.tableActionReference.lparen_rparen name argumentList) with
               | NanoP4Spec.tableActionReference.lparen_rparen _ _ => true
               | _ => false) : Bool) =
           true) →
        (NanoP4Spec.Statement_eval
           NanoP4Spec.scope.BLOCK
           EC_0
           (NanoP4Spec.callStatement.to_statement
              (NanoP4Spec.callStatement.lparen_rparen_semi
                 (NanoP4Spec.nonTypeName.to_lvalue name)
                 argumentList))
           EC_1) →
        NanoP4Spec.TableMatch_eval EC_0 value_tableKey «tableEntry*» EC_1

end

theorem Call_eval.run_sound_group [Externs] :
    (∀
         (p0 : NanoP4Spec.scope)
         (p1 : NanoP4Spec.evalContext)
         (p2 : NanoP4Spec.callee)
         (p3 : List NanoP4Spec.argument)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Call_eval.run p0 p1 p2 p3 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Call_eval p0 p1 p2 p3 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.tableProperties)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Table_eval.run p0 p1 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Table_eval p0 p1 o) ∧
    (∀
         (p0 : NanoP4Spec.scope)
         (p1 : NanoP4Spec.evalContext)
         (p2 : NanoP4Spec.statement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Statement_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Statement_eval p0 p1 p2 o) ∧
    (∀
         (p0 : NanoP4Spec.scope)
         (p1 : NanoP4Spec.evalContext)
         (p2 : List NanoP4Spec.statement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Statements_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Statements_eval p0 p1 p2 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.blockStatement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Block_eval.run p0 p1 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Block_eval p0 p1 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.value)
         (p2 : List NanoP4Spec.tableEntry)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.TableMatch_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.TableMatch_eval p0 p1 p2 o) := by
  run_sound_group NanoP4Spec.Call_eval.run.mutual_partial_correctness

