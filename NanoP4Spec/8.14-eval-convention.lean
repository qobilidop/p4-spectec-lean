         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Call_eval.run p0 p1 p2 p3 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Call_eval p0 p1 p2 p3 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.tableProperties)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Table_eval.run p0 p1 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Table_eval p0 p1 o) ∧
    (∀
         (p0 : NanoP4Spec.scope)
         (p1 : NanoP4Spec.evalContext)
         (p2 : NanoP4Spec.statement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Statement_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Statement_eval p0 p1 p2 o) ∧
    (∀
         (p0 : NanoP4Spec.scope)
         (p1 : NanoP4Spec.evalContext)
         (p2 : List NanoP4Spec.statement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Statements_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Statements_eval p0 p1 p2 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.blockStatement)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.Block_eval.run p0 p1 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.Block_eval p0 p1 o) ∧
    (∀
         (p0 : NanoP4Spec.evalContext)
         (p1 : NanoP4Spec.value)
         (p2 : List NanoP4Spec.tableEntry)
         (r : Except Fail NanoP4Spec.evalContext),
         NanoP4Spec.TableMatch_eval.run p0 p1 p2 = some r →
         ∀ (o : NanoP4Spec.evalContext), r = .ok o →
         NanoP4Spec.TableMatch_eval p0 p1 p2 o) := by
  run_sound_group NanoP4Spec.Call_eval.run.mutual_partial_correctness

