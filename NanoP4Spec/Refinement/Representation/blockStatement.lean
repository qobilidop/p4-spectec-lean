def Faithful (input : P4SpecTec.Lang.Il.typ') (v : P4SpecTec.Lang.Il.value) : Prop :=
  ∀ family, Matches input family → ∀ fuel x, decode family fuel v = some x →
    admitted family x ∧ Rel v (encode family x)

/-- Independently checked leaf contracts in this finite closure. -/
