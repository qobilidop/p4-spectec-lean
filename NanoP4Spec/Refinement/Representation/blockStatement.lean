      (List.replicate raws.length element) raws) :
    ∀ raw ∈ raws, Witness element.it raw := by
  induction raws with
  | nil => intro raw member; cases member
  | cons raw raws rec =>
    simp only [List.length_cons, List.replicate_succ] at ih
    cases ih with
    | cons head tail =>
      intro rawValue member
      rcases List.mem_cons.mp member with rfl | member
      · exact head
      · exact rec tail rawValue member

/-- Records retain their source declaration family. -/
private theorem recordSourceWitness (name : P4SpecTec.Lang.Il.id) (arguments : List
  P4SpecTec.Lang.Il.typ)
    (parameters : List P4SpecTec.Lang.Il.tparam) (sourceFields : List
      P4SpecTec.Lang.Il.typfield)
    (v : P4SpecTec.Lang.Il.value) (declared : Representation.Source.body NanoP4Spec.spec name.it
      =
      some (parameters, .StructT sourceFields))
    (whole : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (.VarT name arguments) v) :
    Witness (.VarT name arguments) v := by
  intro family matching
  cases matching with
    | f0 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Brack (Q.a .LBrace) (.Arg (Q.t (Q.varT
            "statementList" []))) (Q.a .RBrace)) "blockStatement" []])).it) := by
        rw [nameEq]; rfl
      simp only [actual, Option.some.injEq, Prod.mk.injEq] at declared
      obtain ⟨_, impossible⟩ := declared
      cases impossible
    | f1 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Atom (Q.a (.Operator ";"))) "emptyStatement" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "type" [])), .Arg (Q.t (Q.varT "name" [])), .Arg (Q.t
            (Q.varT "initializer" [])), .Atom (Q.a (.Operator ";"))]) "variableDeclaration" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "lvalue" [])), .Atom (Q.a (.Operator "=")), .Arg (Q.t
            (Q.varT "expression" [])), .Atom (Q.a (.Operator ";"))]) "assignmentStatement" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "lvalue" [])), .Brack (Q.a .LParen) (.Arg (Q.t (Q.varT
            "argumentList" []))) (Q.a .RParen), .Atom (Q.a (.Operator ";"))]) "callStatement"
            [], Q.tc (.Brack (Q.a .LBrace) (.Arg (Q.t (Q.varT "statementList" []))) (Q.a
            .RBrace)) "blockStatement" [], Q.tc (.Seq [.Atom (Q.a (.Keyword "IF")), .Brack (Q.a
            .LParen) (.Arg (Q.t (Q.varT "expression" []))) (Q.a .RParen), .Arg (Q.t (Q.varT
            "blockStatement" [])), .Atom (Q.a (.Keyword "ELSE")), .Arg (Q.t (Q.varT
            "blockStatement" []))]) "conditionalStatement" []])).it) := by
        rw [nameEq]; rfl
      simp only [actual, Option.some.injEq, Prod.mk.injEq] at declared
      obtain ⟨_, impossible⟩ := declared
      cases impossible
    | f2 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Atom (Q.a (.Tag "EMPTY"))) "statementList" [], Q.tc
            (.Seq [.Arg (Q.t (Q.varT "statementList" [])), .Arg (Q.t (Q.varT "statement" []))])
            "statementList" []])).it) := by
        rw [nameEq]; rfl
      simp only [actual, Option.some.injEq, Prod.mk.injEq] at declared
      obtain ⟨_, impossible⟩ := declared
      cases impossible
    | f3 name nameEq =>
      exact leafWitness _ v .f3 rfl (.f3 name nameEq ) whole
    | f4 name nameEq =>
      exact leafWitness _ v .f4 rfl (.f4 name nameEq ) whole
    | f5 name nameEq =>
      exact leafWitness _ v .f5 rfl (.f5 name nameEq ) whole
    | f6 name nameEq =>
      exact leafWitness _ v .f6 rfl (.f6 name nameEq ) whole
    | f7 name nameEq =>
      exact leafWitness _ v .f7 rfl (.f7 name nameEq ) whole
    | f8 name nameEq =>
      exact leafWitness _ v .f8 rfl (.f8 name nameEq ) whole

/-- Source external declarations use independent checked leaf codecs. -/
private theorem externalSourceWitness (name : P4SpecTec.Lang.Il.id) (v :
  P4SpecTec.Lang.Il.value)
    (declared : Representation.Source.external NanoP4Spec.spec name.it = true)
    (payload : Representation.Source.externDomain.external name.it v) : Witness (.VarT name [])
      v := by
  intro family matching
  cases matching with
    | f0 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Brack (Q.a .LBrace) (.Arg (Q.t (Q.varT
            "statementList" []))) (Q.a .RBrace)) "blockStatement" []])).it) := by
        rw [nameEq]; rfl
      have impossible := Representation.Source.externalFalseOfBody actual
      rw [impossible] at declared
      cases declared
    | f1 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Atom (Q.a (.Operator ";"))) "emptyStatement" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "type" [])), .Arg (Q.t (Q.varT "name" [])), .Arg (Q.t
            (Q.varT "initializer" [])), .Atom (Q.a (.Operator ";"))]) "variableDeclaration" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "lvalue" [])), .Atom (Q.a (.Operator "=")), .Arg (Q.t
            (Q.varT "expression" [])), .Atom (Q.a (.Operator ";"))]) "assignmentStatement" [],
            Q.tc (.Seq [.Arg (Q.t (Q.varT "lvalue" [])), .Brack (Q.a .LParen) (.Arg (Q.t (Q.varT
            "argumentList" []))) (Q.a .RParen), .Atom (Q.a (.Operator ";"))]) "callStatement"
            [], Q.tc (.Brack (Q.a .LBrace) (.Arg (Q.t (Q.varT "statementList" []))) (Q.a
            .RBrace)) "blockStatement" [], Q.tc (.Seq [.Atom (Q.a (.Keyword "IF")), .Brack (Q.a
            .LParen) (.Arg (Q.t (Q.varT "expression" []))) (Q.a .RParen), .Arg (Q.t (Q.varT
            "blockStatement" [])), .Atom (Q.a (.Keyword "ELSE")), .Arg (Q.t (Q.varT
            "blockStatement" []))]) "conditionalStatement" []])).it) := by
        rw [nameEq]; rfl
      have impossible := Representation.Source.externalFalseOfBody actual
      rw [impossible] at declared
      cases declared
    | f2 name nameEq =>
      have actual : Representation.Source.body NanoP4Spec.spec name.it =
          some ([], (Q.dt (.VariantT [Q.tc (.Atom (Q.a (.Tag "EMPTY"))) "statementList" [], Q.tc
            (.Seq [.Arg (Q.t (Q.varT "statementList" [])), .Arg (Q.t (Q.varT "statement" []))])
            "statementList" []])).it) := by
        rw [nameEq]; rfl
      have impossible := Representation.Source.externalFalseOfBody actual
      rw [impossible] at declared
      cases declared
    | f3 name nameEq =>
      exact leafWitness _ v .f3 rfl (.f3 name nameEq)
        (Representation.Source.Valid.external name v declared payload)
    | f4 name nameEq =>
      exact leafWitness _ v .f4 rfl (.f4 name nameEq)
        (Representation.Source.Valid.external name v declared payload)
    | f5 name nameEq =>
      exact leafWitness _ v .f5 rfl (.f5 name nameEq)
        (Representation.Source.Valid.external name v declared payload)
    | f6 name nameEq =>
      exact leafWitness _ v .f6 rfl (.f6 name nameEq)
        (Representation.Source.Valid.external name v declared payload)
    | f7 name nameEq =>
      exact leafWitness _ v .f7 rfl (.f7 name nameEq)
        (Representation.Source.Valid.external name v declared payload)
    | f8 name nameEq =>
      exact leafWitness _ v .f8 rfl (.f8 name nameEq)
        (Representation.Source.Valid.external name v declared payload)

/-- Complete actual decoder facts by independent source derivation. -/
private theorem sourceWitness {input : P4SpecTec.Lang.Il.typ'} {v : P4SpecTec.Lang.Il.value}
    (valid : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      input v) :
    Witness input v := by
  apply Representation.Source.Valid.rec (motive_1 := fun type v _ => Witness type v)
    (motive_2 := fun types raws _ =>
      List.Forall₂ (fun type raw => Witness type.it raw) types raws) (t := valid)
  · intro v b shape family matching
    cases matching
  · intro v n shape family matching
    cases matching
  · intro v n shape family matching
    cases matching
  · intro v text shape family matching
    cases matching
  · intro element v raws shape payload ih family matching
    cases matching
  · intro element v shape family matching
    cases matching
  · intro element v raw shape payload ih family matching
    cases matching
  · intro types v raws shape payload ih family matching; cases matching
  · intro name arguments parameters definition instantiated v declared fields payload ih
    exact aliasSourceWitness name arguments parameters definition instantiated v
      declared fields ih (.alias name arguments parameters definition instantiated v
        declared fields payload)
  · intro name arguments parameters sourceFields instantiated v valueFields declared
      shape labels fields payload ih
    exact recordSourceWitness name arguments parameters sourceFields v declared
      (.record name arguments parameters sourceFields instantiated v valueFields
        declared shape labels fields payload)
  · intro name arguments parameters cases constructor instantiated v tree declared member
      shape mixop fields payload ih
    exact variantSourceWitness leafWitness name arguments parameters cases constructor
      instantiated v tree declared member shape mixop fields ih
      (.variant name arguments parameters cases constructor instantiated v tree
        declared member shape mixop fields payload)
  · exact externalSourceWitness
  · intro name arguments v payload
    exact absurd payload (Representation.Source.externDomainNoRuntime _ v)
  · exact .nil
  · intro type v types values head tail ihHead ihTail; exact .cons ihHead ihTail

#audit_axioms witnessesList
#audit_axioms listChildrenWitness
#audit_axioms recordSourceWitness
#audit_axioms externalSourceWitness
#audit_axioms sourceWitness

