/-- Finite child witnesses preserve every list position without a depth cutoff. -/
private theorem witnessesList (child : Family) (raws : List P4SpecTec.Lang.Il.value)
    (children : ∀ raw ∈ raws, ∃ x, Representation.Decodes (decode child) raw x) :
    ∃ xs, List.Forall₂ (Representation.Decodes (decode child)) raws xs := by
  induction raws with
  | nil => exact ⟨[], .nil⟩
  | cons raw raws ih =>
    obtain ⟨x, head⟩ := children raw (by simp)
    obtain ⟨xs, tail⟩ := ih (fun raw member => children raw (by simp [member]))
    exact ⟨x :: xs, .cons head tail⟩

