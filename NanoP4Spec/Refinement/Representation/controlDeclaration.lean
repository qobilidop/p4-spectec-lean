/-- Every carrier value is admitted under the stated child totals. -/
theorem controlDeclaration.admittedAll : ∀ x : NanoP4Spec.controlDeclaration,
  (NanoP4Spec.controlDeclaration.admitted) x := by
  intro x
  cases x with
  | CONTROL_lparen_rparen_lbrace_APPLY_rbrace x0 x1 x2 x3 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.parameterList),
      (NanoP4Spec.parameterList.admitted) x from NanoP4Spec.parameterList.admittedAll)) x1,
      ((show ∀ x : (NanoP4Spec.controlLocalDeclarationList),
      (NanoP4Spec.controlLocalDeclarationList.admitted) x from
      NanoP4Spec.controlLocalDeclarationList.admittedAll)) x2, ((show ∀ x :
      (NanoP4Spec.controlBody), (NanoP4Spec.controlBody.admitted) x from
      NanoP4Spec.controlBody.admittedAll)) x3, trivial⟩


#audit_axioms NanoP4Spec.controlDeclaration.admittedAll

