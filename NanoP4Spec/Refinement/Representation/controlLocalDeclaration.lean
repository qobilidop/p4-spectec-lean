/-- Every carrier value is admitted under the stated child totals. -/
theorem controlLocalDeclaration.admittedAll : ∀ x : NanoP4Spec.controlLocalDeclaration,
  (NanoP4Spec.controlLocalDeclaration.admitted) x := by
  intro x
  cases x with
  | semi x0 x1 x2 =>
    exact ⟨((show ∀ x : (NanoP4Spec.type), (NanoP4Spec.type.admitted) x from
      NanoP4Spec.type.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.name),
      (NanoP4Spec.name.admitted) x from NanoP4Spec.name.admittedAll)) x1, ((show ∀ x :
      (NanoP4Spec.initializer), (NanoP4Spec.initializer.admitted) x from
      NanoP4Spec.initializer.admittedAll)) x2, trivial⟩
  | TABLE_lbrace_rbrace x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.tableProperties),
      (NanoP4Spec.tableProperties.admitted) x from NanoP4Spec.tableProperties.admittedAll)) x1,
      trivial⟩


