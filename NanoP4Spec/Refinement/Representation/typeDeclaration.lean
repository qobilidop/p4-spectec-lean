  (NanoP4Spec.typeDeclaration.admitted) x := by
  intro x
  cases x with
  | STRUCT_lbrace_rbrace x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.typeFieldList),
      (NanoP4Spec.typeFieldList.admitted) x from NanoP4Spec.typeFieldList.admittedAll)) x1,
      trivial⟩
  | HEADER_lbrace_rbrace x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.typeFieldList),
      (NanoP4Spec.typeFieldList.admitted) x from NanoP4Spec.typeFieldList.admittedAll)) x1,
      trivial⟩
  | PARSER_lparen_rparen_semi x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.parameterList),
      (NanoP4Spec.parameterList.admitted) x from NanoP4Spec.parameterList.admittedAll)) x1,
      trivial⟩
  | CONTROL_lparen_rparen_semi x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.parameterList),
      (NanoP4Spec.parameterList.admitted) x from NanoP4Spec.parameterList.admittedAll)) x1,
      trivial⟩
  | PACKAGE_lparen_rparen_semi x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.parameterList),
