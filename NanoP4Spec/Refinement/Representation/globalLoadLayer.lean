/-- Validity of the actual encoded record is exactly validity of its encoded fields. -/
theorem globalLoadLayer.encodingSourceIff (x : NanoP4Spec.globalLoadLayer) :
    NanoP4Spec.globalLoadLayer.source (NanoP4Spec.globalLoadLayer.toValue x) ↔
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "callableTypeDefEnv" [])).it) ((NanoP4Spec.callableTypeDefEnv.toValue)
      (x.CALLABLE_TYPE)) ∧ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "callableDefEnv" [])).it)
      ((NanoP4Spec.callableDefEnv.toValue) (x.CALLABLE)) ∧ (Representation.Source.Valid
      NanoP4Spec.spec Representation.Source.externDomain (Q.t (.IterT (Q.t (Q.varT
      "parserDeclarationIR" [])) .Opt)).it) ((@ToValue.toValue (Option
      (NanoP4Spec.parserDeclarationIR)) (@P4SpecTec.Prelude.instToValueOption
      (NanoP4Spec.parserDeclarationIR) ⟨NanoP4Spec.parserDeclarationIR.toValue⟩)) (x.PARSER)) ∧
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (.IterT (Q.t (Q.varT "controlDeclarationIR" [])) .Opt)).it) ((@ToValue.toValue (Option
      (NanoP4Spec.controlDeclarationIR)) (@P4SpecTec.Prelude.instToValueOption
      (NanoP4Spec.controlDeclarationIR) ⟨NanoP4Spec.controlDeclarationIR.toValue⟩)) (x.CONTROL))
      ∧ True := by
  rcases x with ⟨x0, x1, x2, x3⟩
  constructor
  · intro valid
    obtain ⟨fields, shape, _labels, valid⟩ := NanoP4Spec.globalLoadLayer.payload _ valid
    have same : [(Q.a ((.Keyword "CALLABLE_TYPE")), (NanoP4Spec.callableTypeDefEnv.toValue) x0),
      (Q.a ((.Keyword "CALLABLE")), (NanoP4Spec.callableDefEnv.toValue) x1), (Q.a ((.Keyword
      "PARSER")), (@ToValue.toValue (Option (NanoP4Spec.parserDeclarationIR))
      (@P4SpecTec.Prelude.instToValueOption (NanoP4Spec.parserDeclarationIR)
      ⟨NanoP4Spec.parserDeclarationIR.toValue⟩)) x2), (Q.a ((.Keyword "CONTROL")),
      (@ToValue.toValue (Option (NanoP4Spec.controlDeclarationIR))
      (@P4SpecTec.Prelude.instToValueOption (NanoP4Spec.controlDeclarationIR)
      ⟨NanoP4Spec.controlDeclarationIR.toValue⟩)) x3)] = fields := Lang.Il.value'.StructV.inj
      shape
    cases same
    dsimp only [NanoP4Spec.globalLoadLayer.sourceTypes, List.map] at valid
    cases valid with
    | cons _ _ _ _ p0 tail =>
      cases tail with
      | cons _ _ _ _ p1 tail =>
        cases tail with
        | cons _ _ _ _ p2 tail =>
          cases tail with
          | cons _ _ _ _ p3 tail =>
            cases tail
            exact ⟨p0, p1, p2, p3, trivial⟩
  · intro valid
    obtain ⟨p0, p1, p2, p3, _⟩ := valid
    apply Representation.Source.RecordDomain.valid (Q.i "globalLoadLayer") [] []
      NanoP4Spec.globalLoadLayer.sourceFields NanoP4Spec.globalLoadLayer.sourceTypes
      (NanoP4Spec.globalLoadLayer.toValue ⟨x0, x1, x2, x3⟩) (by rfl)
      ⟨rfl, .cons (Representation.Source.Substitutes.named (Q.i "callableTypeDefEnv") [] [] rfl
        (.nil)) (.cons (Representation.Source.Substitutes.named (Q.i "callableDefEnv") [] [] rfl
        (.nil)) (.cons (Representation.Source.Substitutes.iter (Q.t (Q.varT
        "parserDeclarationIR" [])) (Q.t (Q.varT "parserDeclarationIR" [])) .Opt
        (Representation.Source.Substitutes.named (Q.i "parserDeclarationIR") [] [] rfl (.nil)))
        (.cons (Representation.Source.Substitutes.iter (Q.t (Q.varT "controlDeclarationIR" []))
        (Q.t (Q.varT "controlDeclarationIR" [])) .Opt (Representation.Source.Substitutes.named
        (Q.i "controlDeclarationIR") [] [] rfl (.nil))) (.nil))))⟩
    exact ⟨_, rfl, .cons (rfl) (.cons (rfl) (.cons (rfl) (.cons (rfl) (.nil)))), .cons _ _ _ _
      p0 (.cons _ _ _ _ p1 (.cons _ _ _ _ p2 (.cons _ _ _ _ p3 (.nil))))⟩

/-- Every carrier value is admitted under the stated child totals. -/
theorem globalLoadLayer.admittedAll : ∀ x : NanoP4Spec.globalLoadLayer,
  (NanoP4Spec.globalLoadLayer.admitted) x := by
  intro x
  exact ⟨((show ∀ x : (NanoP4Spec.callableTypeDefEnv), (NanoP4Spec.callableTypeDefEnv.admitted)
    x from NanoP4Spec.callableTypeDefEnv.admittedAll)) (x.CALLABLE_TYPE), ((show ∀ x :
    (NanoP4Spec.callableDefEnv), (NanoP4Spec.callableDefEnv.admitted) x from
    NanoP4Spec.callableDefEnv.admittedAll)) (x.CALLABLE), ((show ∀ x : (Option
    (NanoP4Spec.parserDeclarationIR)), (fun xs : Option (NanoP4Spec.parserDeclarationIR) => ∀ x
    ∈ xs, (NanoP4Spec.parserDeclarationIR.admitted) x) x from (fun xs x _ => ((show ∀ x :
    (NanoP4Spec.parserDeclarationIR), (NanoP4Spec.parserDeclarationIR.admitted) x from
    NanoP4Spec.parserDeclarationIR.admittedAll)) x))) (x.PARSER), ((show ∀ x : (Option
    (NanoP4Spec.controlDeclarationIR)), (fun xs : Option (NanoP4Spec.controlDeclarationIR) => ∀
    x ∈ xs, (NanoP4Spec.controlDeclarationIR.admitted) x) x from (fun xs x _ => ((show ∀ x :
    (NanoP4Spec.controlDeclarationIR), (NanoP4Spec.controlDeclarationIR.admitted) x from
    NanoP4Spec.controlDeclarationIR.admittedAll)) x))) (x.CONTROL), trivial⟩

