      NanoP4Spec.tableActionsProperty.admittedAll)) x1, trivial⟩
  | mk_2 x0 x1 x2 =>
    exact ⟨((show ∀ x : (NanoP4Spec.tableKeyProperty), (NanoP4Spec.tableKeyProperty.admitted) x
      from NanoP4Spec.tableKeyProperty.admittedAll)) x0, ((show ∀ x :
