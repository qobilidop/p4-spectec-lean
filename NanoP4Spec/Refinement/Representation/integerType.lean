theorem integerType.admittedAll : ∀ x : NanoP4Spec.integerType,
  (NanoP4Spec.integerType.admitted) x := by
  intro x
  cases x with
  | BIT_langle_rangle x0 =>
    exact ⟨((show ∀ x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x0, trivial⟩
  | INT_langle_rangle x0 =>
    exact ⟨((show ∀ x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x0, trivial⟩


