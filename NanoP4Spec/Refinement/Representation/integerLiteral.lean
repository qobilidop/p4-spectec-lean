/-- Every carrier value is admitted under the stated child totals. -/
theorem integerLiteral.admittedAll : ∀ x : NanoP4Spec.integerLiteral,
  (NanoP4Spec.integerLiteral.admitted) x := by
  intro x
  cases x with
  | W x0 x1 =>
    exact ⟨((show ∀ x : (Nat), (fun _ : Nat => True) x from (fun _ => True.intro))) x0, ((show ∀
      x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x1, trivial⟩
  | S x0 x1 =>
    exact ⟨((show ∀ x : (Nat), (fun _ : Nat => True) x from (fun _ => True.intro))) x0, ((show ∀
      x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x1, trivial⟩


#audit_axioms NanoP4Spec.integerLiteral.admittedAll

end NanoP4Spec
