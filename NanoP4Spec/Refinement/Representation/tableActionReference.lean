/-- Every carrier value is admitted under the stated child totals. -/
theorem tableActionReference.admittedAll : ∀ x : NanoP4Spec.tableActionReference,
  (NanoP4Spec.tableActionReference.admitted) x := by
  intro x
  cases x with
  | _ID x0 =>
    exact ⟨((show ∀ x : (ByteText), (fun _ : ByteText => True) x from (fun _ => True.intro)))
      x0, trivial⟩
  | APPLY =>
    trivial
  | KEY =>
    trivial
  | ACTIONS =>
    trivial
  | STATE =>
    trivial
  | lparen_rparen x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from
      NanoP4Spec.name.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.argumentList),
      (NanoP4Spec.argumentList.admitted) x from NanoP4Spec.argumentList.admittedAll)) x1,
      trivial⟩


#audit_axioms NanoP4Spec.tableActionReference.admittedAll

end NanoP4Spec
