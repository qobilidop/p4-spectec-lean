/-- Finite child witnesses preserve every list position without a depth cutoff. -/
private theorem witnessesList (child : Family) (raws : List P4SpecTec.Lang.Il.value)
    (children : ∀ raw ∈ raws, ∃ x, Representation.Decodes (decode child) raw x) :
    ∃ xs, List.Forall₂ (Representation.Decodes (decode child)) raws xs := by
  induction raws with
  | nil => exact ⟨[], .nil⟩
  | cons raw raws ih =>
    obtain ⟨x, head⟩ := children raw (by simp)
    obtain ⟨xs, tail⟩ := ih (fun raw member => children raw (by simp [member]))
    exact ⟨x :: xs, .cons head tail⟩

#audit_axioms witnessesList

/-- Homogeneous source induction supplies every child fidelity fact. -/
private theorem listChildrenWitness (element : P4SpecTec.Lang.Il.typ) (raws : List
  P4SpecTec.Lang.Il.value)
    (ih : List.Forall₂ (fun type raw => Witness type.it raw)
      (List.replicate raws.length element) raws) :
    ∀ raw ∈ raws, Witness element.it raw := by
  induction raws with
  | nil => intro raw member; cases member
  | cons raw raws rec =>
    simp only [List.length_cons, List.replicate_succ] at ih
    cases ih with
    | cons head tail =>
      intro rawValue member
      rcases List.mem_cons.mp member with rfl | member
      · exact head
      · exact rec tail rawValue member

#audit_axioms listChildrenWitness

