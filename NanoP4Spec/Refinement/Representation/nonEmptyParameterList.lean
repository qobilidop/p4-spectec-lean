    obtain ⟨x, stable⟩ := (@Representation.DecoderCorrect.sufficient (NanoP4Spec.direction)
      ⟨NanoP4Spec.direction.toValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "direction" [])).it) (fun _ => True)
      (NanoP4Spec.direction.ofValue) (@Representation.Codec.decoder (NanoP4Spec.direction)
      ⟨NanoP4Spec.direction.toValue⟩ ⟨NanoP4Spec.direction.ofValue⟩ (Representation.Source.Valid
      NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT "direction" [])).it) (fun
      _ => True) (NanoP4Spec.direction.sourceCodec))) v (leafDomain1 matching valid)
    exact ⟨x, stable⟩
  | f2 =>
    obtain ⟨x, stable⟩ := (@Representation.DecoderCorrect.sufficient (NanoP4Spec.type)
      ⟨NanoP4Spec.type.toValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "type" [])).it) (NanoP4Spec.type.admitted)
      (NanoP4Spec.type.ofValue) (@Representation.Codec.decoder (NanoP4Spec.type)
      ⟨NanoP4Spec.type.toValue⟩ ⟨NanoP4Spec.type.ofValue⟩ (Representation.Source.Valid
      NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT "type" [])).it)
      (NanoP4Spec.type.admitted) (NanoP4Spec.type.codec))) v (leafDomain2 matching valid)
    exact ⟨x, stable⟩
  | f3 =>
    obtain ⟨x, stable⟩ := (@Representation.DecoderCorrect.sufficient (NanoP4Spec.name)
      ⟨NanoP4Spec.name.toValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "name" [])).it) (NanoP4Spec.name.admitted)
      (NanoP4Spec.name.ofValue) (@Representation.Codec.decoder (NanoP4Spec.name)
      ⟨NanoP4Spec.name.toValue⟩ ⟨NanoP4Spec.name.ofValue⟩ (Representation.Source.Valid
      NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT "name" [])).it)
      (NanoP4Spec.name.admitted) (NanoP4Spec.name.codec))) v (leafDomain3 matching valid)
