      (NanoP4Spec.parameter.admitted) (NanoP4Spec.parameter.ofValue)
      (@Representation.Codec.decoder (NanoP4Spec.parameter) ⟨NanoP4Spec.parameter.toValue⟩
      ⟨NanoP4Spec.parameter.ofValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "parameter" [])).it)
      (NanoP4Spec.parameter.admitted) (NanoP4Spec.parameter.codec))) v (leafDomain4 matching
