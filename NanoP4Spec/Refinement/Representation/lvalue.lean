/-- Homogeneous source induction supplies every child fidelity fact. -/
private theorem listChildrenWitness (element : P4SpecTec.Lang.Il.typ) (raws : List
  P4SpecTec.Lang.Il.value)
    (ih : List.Forall₂ (fun type raw => Witness type.it raw)
      (List.replicate raws.length element) raws) :
    ∀ raw ∈ raws, Witness element.it raw := by
  induction raws with
  | nil => intro raw member; cases member
  | cons raw raws rec =>
    simp only [List.length_cons, List.replicate_succ] at ih
    cases ih with
    | cons head tail =>
      intro rawValue member
      rcases List.mem_cons.mp member with rfl | member
      · exact head
      · exact rec tail rawValue member

