/-- Structural source admission for the actual generated carrier. -/
inductive AdmittedF0 : Carrier .f0 → Prop where
  | _ID (x0 : Carrier .f1) (h0 : (fun _ : ByteText => True) x0) : AdmittedF0
    (NanoP4Spec.lvalue._ID x0)
  | APPLY : AdmittedF0 (NanoP4Spec.lvalue.APPLY )
  | KEY : AdmittedF0 (NanoP4Spec.lvalue.KEY )
  | ACTIONS : AdmittedF0 (NanoP4Spec.lvalue.ACTIONS )
  | STATE : AdmittedF0 (NanoP4Spec.lvalue.STATE )
  | dot (x0 : Carrier .f0) (x1 : Carrier .f2) (h0 : AdmittedF0 x0) (h1 :
    (NanoP4Spec.member.admitted) x1) : AdmittedF0 (NanoP4Spec.lvalue.dot x0 x1)
  | lparen_rparen (x0 : Carrier .f0) (h0 : AdmittedF0 x0) : AdmittedF0
    (NanoP4Spec.lvalue.lparen_rparen x0)

/-- Structural admission excludes runtime-only constructors recursively. -/
def admitted : (family : Family) → Carrier family → Prop
  | .f0, x => AdmittedF0 x
  | .f1, x => (fun _ : ByteText => True) x
  | .f2, x => (NanoP4Spec.member.admitted) x

