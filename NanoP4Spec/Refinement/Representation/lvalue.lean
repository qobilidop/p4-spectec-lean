/-- Every structurally admitted generated value belongs to its full source grammar. -/
theorem encodingValid (family : Family) (x : Carrier family)
    (accepted : admitted family x) :
    Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (source family) (encode family x) := by
  cases family with
  | f0 =>
    exact AdmittedF0.rec
      (motive := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f0) (encode .f0 (x)))
      (fun x0 h0 => encodeBranch0_0 x0 (encodeLeaf1 x0 h0))
      encodeBranch0_1
      encodeBranch0_2
      encodeBranch0_3
      encodeBranch0_4
      (fun x0 x1 _h0 h1 ih0 => encodeBranch0_5 x0 x1 ih0 (encodeLeaf2 x1 h1))
      (fun x0 _h0 ih0 => encodeBranch0_6 x0 ih0)
      accepted
  | f1 => exact encodeLeaf1 x accepted
  | f2 => exact encodeLeaf2 x accepted

#audit_axioms encodingValid

