/-- Checked source leaf codecs supply actual decoder facts. -/
private theorem leafCorrect (input : P4SpecTec.Lang.Il.typ') (v : P4SpecTec.Lang.Il.value)
  (family : Family)
    (leaf : isLeaf family = true) (matching : Matches input family)
    (valid : Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain input v)
    (fuel : Nat) (x : Carrier family) (decoded : decode family fuel v = some x) :
    admitted family x ∧ Rel v (encode family x) := by
  cases family with
  | f0 =>
    cases leaf
  | f1 =>
    exact (@Representation.DecoderCorrect.sound (ByteText) ⟨@ToValue.toValue ByteText
      P4SpecTec.Prelude.instToValueByteText⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t .TextT).it) (fun _ : ByteText => True)
      (@OfValue.ofValue ByteText P4SpecTec.Prelude.instOfValueByteText)
      (@Representation.Codec.decoder (ByteText) ⟨@ToValue.toValue ByteText
      P4SpecTec.Prelude.instToValueByteText⟩ ⟨@OfValue.ofValue ByteText
      P4SpecTec.Prelude.instOfValueByteText⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t .TextT).it) (fun _ : ByteText => True)
      (@Representation.Source.textCodec NanoP4Spec.spec Representation.Source.externDomain)))
      fuel v x (leafDomain1 matching valid) decoded
  | f2 =>
    exact (@Representation.DecoderCorrect.sound (NanoP4Spec.member) ⟨NanoP4Spec.member.toValue⟩
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "member" [])).it) (NanoP4Spec.member.admitted) (NanoP4Spec.member.ofValue)
      (@Representation.Codec.decoder (NanoP4Spec.member) ⟨NanoP4Spec.member.toValue⟩
      ⟨NanoP4Spec.member.ofValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "member" [])).it)
      (NanoP4Spec.member.admitted) (NanoP4Spec.member.codec))) fuel v x (leafDomain2 matching
      valid) decoded

