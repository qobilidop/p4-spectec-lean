/-- Actual recursive decoders cover the independently quoted source grammar. -/
private theorem decoderCorrect (family : Family) :
    @Representation.DecoderCorrect (Carrier family) ⟨encode family⟩
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
        (source family)) (admitted family) (decode family) := by
  letI : ToValue (Carrier family) := ⟨encode family⟩
  constructor
  · intro fuel v x valid decoded
    exact sourceFaithful valid family (sourceMatches family) fuel x decoded
  · intro v valid
    exact sourceWitness valid family (sourceMatches family)

#audit_axioms decoderCorrect

end lvalueSourceCodec

/-- Recursive admission excludes runtime-only constructors. -/
def lvalue.admitted (x : NanoP4Spec.lvalue) : Prop :=
  lvalueSourceCodec.admitted .f0 x

/-- Exact recursive codec for the complete quoted source grammar. -/
theorem lvalue.codec : @Representation.Codec NanoP4Spec.lvalue ⟨NanoP4Spec.lvalue.toValue⟩
  ⟨NanoP4Spec.lvalue.ofValue⟩
    (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.varT
      "lvalue" [])) lvalue.admitted := by
  letI : ToValue NanoP4Spec.lvalue := ⟨NanoP4Spec.lvalue.toValue⟩
  letI : OfValue NanoP4Spec.lvalue := ⟨NanoP4Spec.lvalue.ofValue⟩
  constructor
  · intro x accepted
    exact lvalueSourceCodec.encodingValid .f0 x accepted
  · exact lvalueSourceCodec.decoderCorrect .f0

#audit_axioms lvalue.codec

