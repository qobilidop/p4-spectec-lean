      ⟨@ToValue.toValue ByteText P4SpecTec.Prelude.instToValueByteText⟩
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      .TextT).it) (fun _ : ByteText => True) (@OfValue.ofValue ByteText
      P4SpecTec.Prelude.instOfValueByteText) (@Representation.Codec.decoder (ByteText)
      ⟨@ToValue.toValue ByteText P4SpecTec.Prelude.instToValueByteText⟩ ⟨@OfValue.ofValue
      ByteText P4SpecTec.Prelude.instOfValueByteText⟩ (Representation.Source.Valid
      NanoP4Spec.spec Representation.Source.externDomain (Q.t .TextT).it) (fun _ : ByteText =>
      True) (@Representation.Source.textCodec NanoP4Spec.spec
      Representation.Source.externDomain))) v (leafDomain1 matching valid)
    exact ⟨x, stable⟩
  | f2 =>
    obtain ⟨x, stable⟩ := (@Representation.DecoderCorrect.sufficient (NanoP4Spec.member)
      ⟨NanoP4Spec.member.toValue⟩ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "member" [])).it)
      (NanoP4Spec.member.admitted) (NanoP4Spec.member.ofValue) (@Representation.Codec.decoder
      (NanoP4Spec.member) ⟨NanoP4Spec.member.toValue⟩ ⟨NanoP4Spec.member.ofValue⟩
