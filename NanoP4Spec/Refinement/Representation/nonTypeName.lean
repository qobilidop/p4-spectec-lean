/-- Every carrier value is admitted under the stated child totals. -/
theorem nonTypeName.admittedAll : ∀ x : NanoP4Spec.nonTypeName,
  (NanoP4Spec.nonTypeName.admitted) x := by
  intro x
  cases x with
  | _ID x0 =>
    exact ⟨((show ∀ x : (ByteText), (fun _ : ByteText => True) x from (fun _ => True.intro)))
      x0, trivial⟩
  | APPLY =>
    trivial
  | KEY =>
    trivial
  | ACTIONS =>
    trivial
  | STATE =>
    trivial


