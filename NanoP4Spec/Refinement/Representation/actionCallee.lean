/-- Every carrier value is admitted under the stated child totals. -/
theorem actionCallee.admittedAll : ∀ x : NanoP4Spec.actionCallee,
  (NanoP4Spec.actionCallee.admitted) x := by
  intro x
  cases x with
  | ACTION_lparen_rparen x0 x1 x2 =>
    exact ⟨((show ∀ x : (NanoP4Spec.callableId), (fun _ => True) x from
      NanoP4Spec.callableId.admittedAll)) x0, ((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun
      xs : List (NanoP4Spec.parameterIR) => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x
      from (fun xs x _ => ((show ∀ x : (NanoP4Spec.parameterIR),
      (NanoP4Spec.parameterIR.admitted) x from NanoP4Spec.parameterIR.admittedAll)) x))) x1,
      ((show ∀ x : (NanoP4Spec.blockStatement), (NanoP4Spec.blockStatement.admitted) x from
      NanoP4Spec.blockStatement.admittedAll)) x2, trivial⟩


