/-- Actual decoder fidelity with independently structural admission. -/
def Faithful (input : P4SpecTec.Lang.Il.typ') (v : P4SpecTec.Lang.Il.value) : Prop :=
  ∀ family, Matches input family → ∀ fuel x, decode family fuel v = some x →
    admitted family x ∧ Rel v (encode family x)

/-- Independently checked leaf contracts in this finite closure. -/
def isLeaf : Family → Bool
  | .f0 => false
  | .f1 => false
  | .f2 => true
  | .f3 => true
  | .f4 => true
  | .f5 => true
  | .f6 => true
  | .f7 => false
  | .f8 => true
  | .f9 => true

/-- Source constructors supply recursive child codec facts. -/
private theorem variantSourceFaithful
    (leafCorrect : ∀ input v family, isLeaf family = true → Matches input family →
      Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain input v →
      ∀ fuel x, decode family fuel v = some x →
        admitted family x ∧ Rel v (encode family x))
    (name : P4SpecTec.Lang.Il.id) (arguments : List P4SpecTec.Lang.Il.typ) (parameters : List
      P4SpecTec.Lang.Il.tparam)
    (cases : List P4SpecTec.Lang.Il.typcase) (constructor : P4SpecTec.Lang.Il.typcase)
      (instantiated : List P4SpecTec.Lang.Il.typ)
    (v : P4SpecTec.Lang.Il.value) (tree : P4SpecTec.Domain.Mixfix.t P4SpecTec.Lang.Il.value)
    (declared : Representation.Source.body NanoP4Spec.spec name.it =
      some (parameters, .VariantT cases)) (member : constructor ∈ cases)
    (shape : v.it = .CaseV tree)
    (mixopMatches : P4SpecTec.Domain.Mixfix.eq_mixop tree constructor.nottyp.it = true)
    (fields : Representation.Source.instantiatedFields parameters arguments
      (P4SpecTec.Domain.Mixfix.args constructor.nottyp.it) instantiated)
    (ih : List.Forall₂ (fun type v => Faithful type.it v)
      instantiated (P4SpecTec.Domain.Mixfix.args tree))
    (whole : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (.VarT name arguments) v) :
    Faithful (.VarT name arguments) v := by
  intro family matching
  cases matching with
  | f0 name nameEq =>
    have actual : Representation.Source.body NanoP4Spec.spec name.it =
        some ([], (Q.dt (.VariantT [Q.tc (.Seq [.Arg (Q.t (Q.varT "value" [])), .Arg (Q.t
          (Q.varT "nameIR" [])), .Atom (Q.a (.Operator ";"))]) "fieldValue" []])).it) := by
      rw [nameEq]; rfl
    cases Option.some.inj (declared.symm.trans actual)
    change constructor ∈ [Q.tc (.Seq [.Arg (Q.t (Q.varT "value" [])), .Arg (Q.t (Q.varT "nameIR"
      [])), .Atom (Q.a (.Operator ";"))]) "fieldValue" []] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl
    · have originalArgs : P4SpecTec.Domain.Mixfix.args ((.Seq [.Arg (Q.t (Q.varT "value" [])),
        .Arg (Q.t (Q.varT
        "nameIR" [])), .Atom (Q.a (.Operator ";"))]) : P4SpecTec.Domain.Mixfix.t
          P4SpecTec.Lang.Il.typ) = [Q.t (Q.varT "value" []),
        Q.t (Q.varT "nameIR" [])] := by
        simp only [P4SpecTec.Domain.Mixfix.args, List.flatMap_cons, List.flatMap_nil] <;> rfl
