/-- Plain source aliases preserve fidelity at arbitrary recursive depth. -/
private theorem aliasSourceWitness
    (name : P4SpecTec.Lang.Il.id) (arguments : List P4SpecTec.Lang.Il.typ) (parameters : List
      P4SpecTec.Lang.Il.tparam)
    (definition instantiated : P4SpecTec.Lang.Il.typ) (v : P4SpecTec.Lang.Il.value)
    (declared : Representation.Source.body NanoP4Spec.spec name.it =
      some (parameters, .PlainT definition))
    (fields : Representation.Source.instantiatedFields parameters arguments
      [definition] [instantiated]) (ih : Witness instantiated.it v)
    (whole : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (.VarT name arguments) v) : Witness (.VarT name arguments) v := by
  intro family matching
  cases matching with
  | f0 name nameEq =>
    have actual : Representation.Source.body NanoP4Spec.spec name.it =
        some ([], (Q.dt (.VariantT [Q.tc (.Seq [.Arg (Q.t (Q.varT "value" [])), .Arg (Q.t
          (Q.varT "nameIR" [])), .Atom (Q.a (.Operator ";"))]) "fieldValue" []])).it) := by
      rw [nameEq]; rfl
    simp only [actual, Option.some.injEq, Prod.mk.injEq] at declared
    obtain ⟨_, impossible⟩ := declared
    cases impossible
  | f1 name nameEq =>
    have actual : Representation.Source.body NanoP4Spec.spec name.it =
        some ([], (Q.dt (.VariantT [Q.tc (.Seq [.Arg (Q.t (.NumT .NatT)), .Atom (Q.a (.Keyword
          "W")), .Arg (Q.t (.NumT .IntT))]) "integerLiteral" [], Q.tc (.Seq [.Arg (Q.t (.NumT
          .NatT)), .Atom (Q.a (.Keyword "S")), .Arg (Q.t (.NumT .IntT))]) "integerLiteral" [],
          Q.tc (.Seq [.Atom (Q.a (.Tag "B")), .Arg (Q.t .BoolT)]) "boolValue" [], Q.tc (.Seq
          [.Atom (Q.a (.Keyword "MATCH_KIND")), .Atom (Q.a (.Operator ".")), .Arg (Q.t (Q.varT
          "nameIR" []))]) "matchKindValue" [], Q.tc (.Seq [.Atom (Q.a (.Keyword "STRUCT")), .Arg
          (Q.t (Q.varT "typeId" [])), .Brack (Q.a .LBrace) (.Arg (Q.t (.IterT (Q.t (Q.varT
          "fieldValue" [])) .List))) (Q.a .RBrace)]) "structValue" [], Q.tc (.Seq [.Atom (Q.a
          (.Keyword "HEADER")), .Arg (Q.t (Q.varT "typeId" [])), .Brack (Q.a .LBrace) (.Arg (Q.t
          (.IterT (Q.t (Q.varT "fieldValue" [])) .List))) (Q.a .RBrace)]) "headerValue" [], Q.tc
          (.Seq [.Atom (Q.a (.Keyword "PACKET")), .Arg (Q.t (Q.varT "typeId" [])), .Arg (Q.t
