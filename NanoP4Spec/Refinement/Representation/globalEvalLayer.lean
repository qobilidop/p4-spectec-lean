                rcases f2 with ⟨a2, v2⟩
                rcases f3 with ⟨a3, v3⟩
                rcases f4 with ⟨a4, v4⟩
                dsimp only [NanoP4Spec.globalEvalLayer.sourceTypes, List.map] at valid
                cases valid with
                | cons _ _ _ _ p0 tail =>
                  cases tail with
                  | cons _ _ _ _ p1 tail =>
                    cases tail with
                    | cons _ _ _ _ p2 tail =>
                      cases tail with
                      | cons _ _ _ _ p3 tail =>
                        cases tail with
                        | cons _ _ _ _ p4 tail =>
                          cases tail
                          obtain ⟨x0, b0, h0⟩ :=
                            (@Representation.DecoderCorrect.sufficient (NanoP4Spec.typeDefEnv)
                              ⟨NanoP4Spec.typeDefEnv.toValue⟩ (Representation.Source.Valid
                              NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT
                              "typeDefEnv" [])).it) (NanoP4Spec.typeDefEnv.admitted)
                              (NanoP4Spec.typeDefEnv.ofValue) (@Representation.Codec.decoder
                              (NanoP4Spec.typeDefEnv) ⟨NanoP4Spec.typeDefEnv.toValue⟩
                              ⟨NanoP4Spec.typeDefEnv.ofValue⟩ (Representation.Source.Valid
                              NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT
                              "typeDefEnv" [])).it) (NanoP4Spec.typeDefEnv.admitted)
                              (globalEvalLayer.fieldCodec0))) v0 p0
                          obtain ⟨x1, b1, h1⟩ :=
                            (@Representation.DecoderCorrect.sufficient
                              (NanoP4Spec.callableDefEnv) ⟨NanoP4Spec.callableDefEnv.toValue⟩
                              (Representation.Source.Valid NanoP4Spec.spec
                              Representation.Source.externDomain (Q.t (Q.varT "callableDefEnv"
                              [])).it) (NanoP4Spec.callableDefEnv.admitted)
                              (NanoP4Spec.callableDefEnv.ofValue) (@Representation.Codec.decoder
                              (NanoP4Spec.callableDefEnv) ⟨NanoP4Spec.callableDefEnv.toValue⟩
                              ⟨NanoP4Spec.callableDefEnv.ofValue⟩ (Representation.Source.Valid
                              NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT
                              "callableDefEnv" [])).it) (NanoP4Spec.callableDefEnv.admitted)
                              (globalEvalLayer.fieldCodec1))) v1 p1
                          obtain ⟨x2, b2, h2⟩ :=
                            (@Representation.DecoderCorrect.sufficient (NanoP4Spec.frame)
                              ⟨NanoP4Spec.frame.toValue⟩ (Representation.Source.Valid
                              NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT
                              "frame" [])).it) (NanoP4Spec.frame.admitted)
                              (NanoP4Spec.frame.ofValue) (@Representation.Codec.decoder
                              (NanoP4Spec.frame) ⟨NanoP4Spec.frame.toValue⟩
                              ⟨NanoP4Spec.frame.ofValue⟩ (Representation.Source.Valid
                              NanoP4Spec.spec Representation.Source.externDomain (Q.t (Q.varT
                              "frame" [])).it) (NanoP4Spec.frame.admitted)
                              (globalEvalLayer.fieldCodec2))) v2 p2
                          obtain ⟨x3, b3, h3⟩ :=
                            (@Representation.DecoderCorrect.sufficient
                              (NanoP4Spec.parserDeclarationIR)
                              ⟨NanoP4Spec.parserDeclarationIR.toValue⟩
                              (Representation.Source.Valid NanoP4Spec.spec
                              Representation.Source.externDomain (Q.t (Q.varT
                              "parserDeclarationIR" [])).it)
                              (NanoP4Spec.parserDeclarationIR.admitted)
                              (NanoP4Spec.parserDeclarationIR.ofValue)
                              (@Representation.Codec.decoder (NanoP4Spec.parserDeclarationIR)
                              ⟨NanoP4Spec.parserDeclarationIR.toValue⟩
                              ⟨NanoP4Spec.parserDeclarationIR.ofValue⟩
                              (Representation.Source.Valid NanoP4Spec.spec
                              Representation.Source.externDomain (Q.t (Q.varT
                              "parserDeclarationIR" [])).it)
                              (NanoP4Spec.parserDeclarationIR.admitted)
                              (globalEvalLayer.fieldCodec3))) v3 p3
                          obtain ⟨x4, b4, h4⟩ :=
                            (@Representation.DecoderCorrect.sufficient
                              (NanoP4Spec.controlDeclarationIR)
                              ⟨NanoP4Spec.controlDeclarationIR.toValue⟩
                              (Representation.Source.Valid NanoP4Spec.spec
                              Representation.Source.externDomain (Q.t (Q.varT
                              "controlDeclarationIR" [])).it)
                              (NanoP4Spec.controlDeclarationIR.admitted)
                              (NanoP4Spec.controlDeclarationIR.ofValue)
                              (@Representation.Codec.decoder (NanoP4Spec.controlDeclarationIR)
                              ⟨NanoP4Spec.controlDeclarationIR.toValue⟩
                              ⟨NanoP4Spec.controlDeclarationIR.ofValue⟩
                              (Representation.Source.Valid NanoP4Spec.spec
                              Representation.Source.externDomain (Q.t (Q.varT
                              "controlDeclarationIR" [])).it)
                              (NanoP4Spec.controlDeclarationIR.admitted)
                              (globalEvalLayer.fieldCodec4))) v4 p4
                          refine ⟨⟨x0, x1, x2, x3, x4⟩, (max b0 (max b1 (max b2 (max b3 (max b4
                            (0)))))) + 1, ?_⟩
                          intro fuel enough
                          cases fuel with
                          | zero => omega
                          | succ fuel =>
                            have enough0 : b0 ≤ fuel := by omega
                            have enough1 : b1 ≤ fuel := by omega
                            have enough2 : b2 ≤ fuel := by omega
                            have enough3 : b3 ≤ fuel := by omega
                            have enough4 : b4 ≤ fuel := by omega
                            change NanoP4Spec.globalEvalLayer.ofValue (fuel + 1) v = _
                            simp only [NanoP4Spec.globalEvalLayer.ofValue, shape]
                            change ((NanoP4Spec.typeDefEnv.ofValue) fuel v0).bind (fun x0 =>
                              ((NanoP4Spec.callableDefEnv.ofValue) fuel v1).bind (fun x1 =>
                              ((NanoP4Spec.frame.ofValue) fuel v2).bind (fun x2 =>
                              ((NanoP4Spec.parserDeclarationIR.ofValue) fuel v3).bind (fun x3 =>
                              ((NanoP4Spec.controlDeclarationIR.ofValue) fuel v4).bind (fun x4
                              => some (⟨x0, x1, x2, x3, x4⟩ : NanoP4Spec.globalEvalLayer)))))) =
                              some ⟨x0, x1, x2, x3, x4⟩
                            rw [h0 fuel enough0, h1 fuel enough1, h2 fuel enough2, h3 fuel
                              enough3, h4 fuel enough4]
                            rfl

/-- Validity of the actual encoded record is exactly validity of its encoded fields. -/
theorem globalEvalLayer.encodingSourceIff (x : NanoP4Spec.globalEvalLayer) :
    NanoP4Spec.globalEvalLayer.source (NanoP4Spec.globalEvalLayer.toValue x) ↔
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "typeDefEnv" [])).it) ((NanoP4Spec.typeDefEnv.toValue) (x.TYPE)) ∧
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "callableDefEnv" [])).it) ((NanoP4Spec.callableDefEnv.toValue) (x.CALLABLE)) ∧
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "frame" [])).it) ((NanoP4Spec.frame.toValue) (x.FRAME)) ∧
      (Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain (Q.t
      (Q.varT "parserDeclarationIR" [])).it) ((NanoP4Spec.parserDeclarationIR.toValue)
      (x.PARSER)) ∧ (Representation.Source.Valid NanoP4Spec.spec
      Representation.Source.externDomain (Q.t (Q.varT "controlDeclarationIR" [])).it)
      ((NanoP4Spec.controlDeclarationIR.toValue) (x.CONTROL)) ∧ True := by
  rcases x with ⟨x0, x1, x2, x3, x4⟩
  constructor
  · intro valid
    obtain ⟨fields, shape, _labels, valid⟩ := NanoP4Spec.globalEvalLayer.payload _ valid
    have same : [(Q.a ((.Keyword "TYPE")), (NanoP4Spec.typeDefEnv.toValue) x0), (Q.a ((.Keyword
      "CALLABLE")), (NanoP4Spec.callableDefEnv.toValue) x1), (Q.a ((.Keyword "FRAME")),
      (NanoP4Spec.frame.toValue) x2), (Q.a ((.Keyword "PARSER")),
      (NanoP4Spec.parserDeclarationIR.toValue) x3), (Q.a ((.Keyword "CONTROL")),
      (NanoP4Spec.controlDeclarationIR.toValue) x4)] = fields := Lang.Il.value'.StructV.inj
      shape
    cases same
    dsimp only [NanoP4Spec.globalEvalLayer.sourceTypes, List.map] at valid
    cases valid with
    | cons _ _ _ _ p0 tail =>
      cases tail with
      | cons _ _ _ _ p1 tail =>
        cases tail with
        | cons _ _ _ _ p2 tail =>
          cases tail with
          | cons _ _ _ _ p3 tail =>
            cases tail with
            | cons _ _ _ _ p4 tail =>
              cases tail
              exact ⟨p0, p1, p2, p3, p4, trivial⟩
  · intro valid
    obtain ⟨p0, p1, p2, p3, p4, _⟩ := valid
    apply Representation.Source.RecordDomain.valid (Q.i "globalEvalLayer") [] []
      NanoP4Spec.globalEvalLayer.sourceFields NanoP4Spec.globalEvalLayer.sourceTypes
      (NanoP4Spec.globalEvalLayer.toValue ⟨x0, x1, x2, x3, x4⟩) (by rfl)
      ⟨rfl, .cons (Representation.Source.Substitutes.named (Q.i "typeDefEnv") [] [] rfl (.nil))
        (.cons (Representation.Source.Substitutes.named (Q.i "callableDefEnv") [] [] rfl (.nil))
        (.cons (Representation.Source.Substitutes.named (Q.i "frame") [] [] rfl (.nil)) (.cons
        (Representation.Source.Substitutes.named (Q.i "parserDeclarationIR") [] [] rfl (.nil))
        (.cons (Representation.Source.Substitutes.named (Q.i "controlDeclarationIR") [] [] rfl
        (.nil)) (.nil)))))⟩
    exact ⟨_, rfl, .cons (rfl) (.cons (rfl) (.cons (rfl) (.cons (rfl) (.cons (rfl) (.nil))))),
      .cons _ _ _ _ p0 (.cons _ _ _ _ p1 (.cons _ _ _ _ p2 (.cons _ _ _ _ p3 (.cons _ _ _ _ p4
      (.nil)))))⟩

