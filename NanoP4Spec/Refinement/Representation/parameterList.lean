/-- Every carrier value is admitted under the stated child totals. -/
theorem parameterList.admittedAll : ∀ x : NanoP4Spec.parameterList,
  (NanoP4Spec.parameterList.admitted) x := by
  intro x
  cases x with
  | _EMPTY =>
    trivial
  | mk x0 x1 x2 =>
    exact ⟨((show ∀ x : (NanoP4Spec.direction), (fun _ => True) x from
      NanoP4Spec.direction.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.type),
      (NanoP4Spec.type.admitted) x from NanoP4Spec.type.admittedAll)) x1, ((show ∀ x :
      (NanoP4Spec.name), (NanoP4Spec.name.admitted) x from NanoP4Spec.name.admittedAll)) x2,
      trivial⟩
  | comma x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.nonEmptyParameterList),
      (NanoP4Spec.nonEmptyParameterList.admitted) x from
      NanoP4Spec.nonEmptyParameterList.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.parameter),
      (NanoP4Spec.parameter.admitted) x from NanoP4Spec.parameter.admittedAll)) x1, trivial⟩


