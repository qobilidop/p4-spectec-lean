/-- Complete actual decoder facts by independent source derivation. -/
private theorem sourceFaithful {input : P4SpecTec.Lang.Il.typ'} {v : P4SpecTec.Lang.Il.value}
    (valid : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      input v) :
    Faithful input v := by
  apply Representation.Source.Valid.rec (motive_1 := fun type v _ => Faithful type v)
    (motive_2 := fun types raws _ =>
      List.Forall₂ (fun type raw => Faithful type.it raw) types raws) (t := valid)
  · intro v b shape family matching
    cases matching
  · intro v n shape family matching
    cases matching with
    | f5 => exact leafCorrect _ v .f5 rfl .f5 (Representation.Source.Valid.nat v n shape)
  · intro v n shape family matching
    cases matching with
    | f6 => exact leafCorrect _ v .f6 rfl .f6 (Representation.Source.Valid.int v n shape)
  · intro v text shape family matching
    cases matching with
    | f7 => exact leafCorrect _ v .f7 rfl .f7 (Representation.Source.Valid.text v text shape)
  · intro element v raws shape payload ih family matching
    cases matching
  · intro element v shape family matching
    cases matching
  · intro element v raw shape payload ih family matching
    cases matching
  · intro types v raws shape payload ih family matching; cases matching
  · intro name arguments parameters definition instantiated v declared fields payload ih
    exact aliasSourceFaithful name arguments parameters definition instantiated v
      declared fields ih (.alias name arguments parameters definition instantiated v
        declared fields payload)
  · intro name arguments parameters sourceFields instantiated v valueFields declared
      shape labels fields payload ih
    exact recordSourceFaithful name arguments parameters sourceFields v declared
      (.record name arguments parameters sourceFields instantiated v valueFields
        declared shape labels fields payload)
  · intro name arguments parameters cases constructor instantiated v tree declared member
      shape mixop fields payload ih
    exact variantSourceFaithful leafCorrect name arguments parameters cases constructor
      instantiated v tree declared member shape mixop fields ih
      (.variant name arguments parameters cases constructor instantiated v tree
        declared member shape mixop fields payload)
  · exact externalSourceFaithful
  · exact .nil
  · intro type v types values head tail ihHead ihTail; exact .cons ihHead ihTail

#audit_axioms sourceFaithful

