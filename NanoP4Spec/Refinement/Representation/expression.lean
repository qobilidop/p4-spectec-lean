/-- Every structurally admitted generated value belongs to its full source grammar. -/
theorem encodingValid (family : Family) (x : Carrier family)
    (accepted : admitted family x) :
    Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (source family) (encode family x) := by
  cases family with
  | f0 =>
    exact AdmittedF0.rec
      (motive_1 := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f0) (encode .f0 (x)))
      (motive_2 := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f1) (encode .f1 (x)))
      (motive_3 := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f2) (encode .f2 (x)))
      (motive_4 := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f3) (encode .f3 (x)))
      (motive_5 := fun x _ => Representation.Source.Valid NanoP4Spec.spec
        Representation.Source.externDomain (source .f4) (encode .f4 (x)))
      encodeBranch0_0
      encodeBranch0_1
      (fun x0 x1 h0 h1 => encodeBranch0_2 x0 x1 (encodeLeaf5 x0 h0) (encodeLeaf6 x1 h1))
      (fun x0 x1 h0 h1 => encodeBranch0_3 x0 x1 (encodeLeaf5 x0 h0) (encodeLeaf6 x1 h1))
      (fun x0 h0 => encodeBranch0_4 x0 (encodeLeaf7 x0 h0))
      encodeBranch0_5
      encodeBranch0_6
      encodeBranch0_7
      encodeBranch0_8
      (fun x0 x1 h0 _h1 ih1 => encodeBranch0_9 x0 x1 (encodeLeaf8 x0 h0) ih1)
      (fun x0 x1 x2 _h0 h1 _h2 ih0 ih2 => encodeBranch0_10 x0 x1 x2 ih0 (encodeLeaf9 x1 h1) ih2)
      (fun x0 x1 _h0 h1 ih0 => encodeBranch0_11 x0 x1 ih0 (encodeLeaf10 x1 h1))
      (fun x0 x1 h0 _h1 ih1 => encodeBranch0_12 x0 x1 (encodeLeaf11 x0 h0) ih1)
