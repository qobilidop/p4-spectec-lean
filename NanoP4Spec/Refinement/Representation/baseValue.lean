/-- Every carrier value is admitted under the stated child totals. -/
theorem baseValue.admittedAll : ∀ x : NanoP4Spec.baseValue, (NanoP4Spec.baseValue.admitted) x :=
  by
  intro x
  cases x with
  | W x0 x1 =>
    exact ⟨((show ∀ x : (Nat), (fun _ : Nat => True) x from (fun _ => True.intro))) x0, ((show ∀
      x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x1, trivial⟩
  | S x0 x1 =>
    exact ⟨((show ∀ x : (Nat), (fun _ : Nat => True) x from (fun _ => True.intro))) x0, ((show ∀
      x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x1, trivial⟩
  | _B x0 =>
    exact ⟨((show ∀ x : (Bool), (fun _ : Bool => True) x from (fun _ => True.intro))) x0,
      trivial⟩
  | MATCH_KIND_dot x0 =>
    exact ⟨((show ∀ x : (NanoP4Spec.nameIR), (fun _ => True) x from
      NanoP4Spec.nameIR.admittedAll)) x0, trivial⟩


