/-- Every carrier value is admitted under the stated child totals. -/
theorem objectTypeIR.admittedAll : ∀ x : NanoP4Spec.objectTypeIR,
  (NanoP4Spec.objectTypeIR.admitted) x := by
  intro x
  cases x with
  | EXTERN x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.typeId), (fun _ => True) x from
      NanoP4Spec.typeId.admittedAll)) x0, ((show ∀ x : (NanoP4Spec.externMethodTypeDefEnv),
      (NanoP4Spec.externMethodTypeDefEnv.admitted) x from
      NanoP4Spec.externMethodTypeDefEnv.admittedAll)) x1, trivial⟩
  | PARSER_lparen_rparen x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.typeId), (fun _ => True) x from
      NanoP4Spec.typeId.admittedAll)) x0, ((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs
      : List (NanoP4Spec.parameterIR) => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from
      (fun xs x _ => ((show ∀ x : (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x
      from NanoP4Spec.parameterIR.admittedAll)) x))) x1, trivial⟩
  | CONTROL_lparen_rparen x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.typeId), (fun _ => True) x from
      NanoP4Spec.typeId.admittedAll)) x0, ((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs
      : List (NanoP4Spec.parameterIR) => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from
      (fun xs x _ => ((show ∀ x : (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x
      from NanoP4Spec.parameterIR.admittedAll)) x))) x1, trivial⟩
  | PACKAGE_lparen_rparen x0 x1 =>
    exact ⟨((show ∀ x : (NanoP4Spec.typeId), (fun _ => True) x from
      NanoP4Spec.typeId.admittedAll)) x0, ((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs
      : List (NanoP4Spec.parameterIR) => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from
      (fun xs x _ => ((show ∀ x : (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x
      from NanoP4Spec.parameterIR.admittedAll)) x))) x1, trivial⟩
  | TABLE x0 =>
    exact ⟨((show ∀ x : (NanoP4Spec.typeId), (fun _ => True) x from
      NanoP4Spec.typeId.admittedAll)) x0, trivial⟩


#audit_axioms NanoP4Spec.objectTypeIR.admittedAll

end NanoP4Spec
