/-- Every carrier value is admitted under the stated child totals. -/
theorem callableTypeDef.admittedAll : ∀ x : NanoP4Spec.callableTypeDef,
  (NanoP4Spec.callableTypeDef.admitted) x := by
  intro x
  cases x with
  | ACTION x0 =>
    exact ⟨((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs : List (NanoP4Spec.parameterIR)
      => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from (fun xs x _ => ((show ∀ x :
      (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x from
      NanoP4Spec.parameterIR.admittedAll)) x))) x0, trivial⟩
  | PARSER x0 =>
    exact ⟨((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs : List (NanoP4Spec.parameterIR)
      => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from (fun xs x _ => ((show ∀ x :
      (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x from
      NanoP4Spec.parameterIR.admittedAll)) x))) x0, trivial⟩
  | CONTROL x0 =>
    exact ⟨((show ∀ x : (List (NanoP4Spec.parameterIR)), (fun xs : List (NanoP4Spec.parameterIR)
      => ∀ x ∈ xs, (NanoP4Spec.parameterIR.admitted) x) x from (fun xs x _ => ((show ∀ x :
      (NanoP4Spec.parameterIR), (NanoP4Spec.parameterIR.admitted) x from
      NanoP4Spec.parameterIR.admittedAll)) x))) x0, trivial⟩


#audit_axioms NanoP4Spec.callableTypeDef.admittedAll

end NanoP4Spec
