/-- Actual decoder fidelity with independently structural admission. -/
def Faithful (input : P4SpecTec.Lang.Il.typ') (v : P4SpecTec.Lang.Il.value) : Prop :=
  ∀ family, Matches input family → ∀ fuel x, decode family fuel v = some x →
    admitted family x ∧ Rel v (encode family x)

/-- Independently checked leaf contracts in this finite closure. -/
def isLeaf : Family → Bool
  | .f0 => false
  | .f1 => false
  | .f2 => false
  | .f3 => false
  | .f4 => false
  | .f5 => true
  | .f6 => true
  | .f7 => true
  | .f8 => true
  | .f9 => false
  | .f10 => false
  | .f11 => true
  | .f12 => true
  | .f13 => false
  | .f14 => false
  | .f15 => false
  | .f16 => false

/-- Source constructors supply recursive child codec facts. -/
private theorem variantSourceFaithful
    (leafCorrect : ∀ input v family, isLeaf family = true → Matches input family →
      Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain input v →
      ∀ fuel x, decode family fuel v = some x →
        admitted family x ∧ Rel v (encode family x))
    (name : P4SpecTec.Lang.Il.id) (arguments : List P4SpecTec.Lang.Il.typ) (parameters : List
      P4SpecTec.Lang.Il.tparam)
    (cases : List P4SpecTec.Lang.Il.typcase) (constructor : P4SpecTec.Lang.Il.typcase)
      (instantiated : List P4SpecTec.Lang.Il.typ)
    (v : P4SpecTec.Lang.Il.value) (tree : P4SpecTec.Domain.Mixfix.t P4SpecTec.Lang.Il.value)
    (declared : Representation.Source.body NanoP4Spec.spec name.it =
      some (parameters, .VariantT cases)) (member : constructor ∈ cases)
    (shape : v.it = .CaseV tree)
    (mixopMatches : P4SpecTec.Domain.Mixfix.eq_mixop tree constructor.nottyp.it = true)
    (fields : Representation.Source.instantiatedFields parameters arguments
      (P4SpecTec.Domain.Mixfix.args constructor.nottyp.it) instantiated)
    (ih : List.Forall₂ (fun type v => Faithful type.it v)
      instantiated (P4SpecTec.Domain.Mixfix.args tree))
    (whole : Representation.Source.Valid NanoP4Spec.spec Representation.Source.externDomain
      (.VarT name arguments) v) :
    Faithful (.VarT name arguments) v := by
  intro family matching
  cases matching with
  | f0 name nameEq =>
    have actual : Representation.Source.body NanoP4Spec.spec name.it =
        some ([], (Q.dt (.VariantT [Q.tc (.Seq [.Arg (Q.t (Q.varT "direction" [])), .Arg (Q.t
          (Q.varT "typeIR" [])), .Arg (Q.t (Q.varT "nameIR" []))]) "parameterIR" []])).it) := by
      rw [nameEq]; rfl
    cases Option.some.inj (declared.symm.trans actual)
    change constructor ∈ [Q.tc (.Seq [.Arg (Q.t (Q.varT "direction" [])), .Arg (Q.t (Q.varT
      "typeIR" [])), .Arg (Q.t (Q.varT "nameIR" []))]) "parameterIR" []] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl
    · have originalArgs : P4SpecTec.Domain.Mixfix.args ((.Seq [.Arg (Q.t (Q.varT "direction"
        [])), .Arg (Q.t
        (Q.varT "typeIR" [])), .Arg (Q.t (Q.varT "nameIR" []))]) : P4SpecTec.Domain.Mixfix.t
          P4SpecTec.Lang.Il.typ) = [Q.t (Q.varT
        "direction" []), Q.t (Q.varT "typeIR" []), Q.t (Q.varT "nameIR" [])] := by
        simp only [P4SpecTec.Domain.Mixfix.args, List.flatMap_cons, List.flatMap_nil] <;> rfl
      obtain ⟨_arity, substitutions⟩ := fields
      dsimp only [Q.tc, P4SpecTec.Lang.Il.typcase.nottyp, Q.nt, Util.Source.mkPhrase]
        at substitutions
      rw [originalArgs] at substitutions
      cases substitutions with
      | cons sub0 rest0 =>
        cases rest0 with
        | cons sub1 rest1 =>
          cases rest1 with
          | cons sub2 rest2 =>
            cases rest2
            generalize argsShape : P4SpecTec.Domain.Mixfix.args tree = raws at ih
            cases ih with
            | @cons t0 a0 ts0 raws0 ih0 tail0 =>
              cases tail0 with
              | @cons t1 a1 ts1 raws1 ih1 tail1 =>
                cases tail1 with
                | @cons t2 a2 ts2 raws2 ih2 tail2 =>
                  cases tail2
                  have matching : P4SpecTec.Domain.Mixfix.eq_mixop tree (((.Seq [(.Arg ()),
                    (.Arg ()), (.Arg
                    ())])) : P4SpecTec.Domain.Mixfix.mixop) = true :=
                    Representation.Source.mixopTrans tree _ _ mixopMatches (by rfl)
                  exact soundBranch0_0 v tree a0 a1 a2 shape matching argsShape (ih0 .f5
                    (matchField0_0 _ sub0)) (ih1 .f4 (matchField0_1 _ sub1)) (ih2 .f6
                    (matchField0_2 _ sub2))
  | f1 name nameEq =>
    have actual : Representation.Source.body NanoP4Spec.spec name.it =
        some ([], (Q.dt (.VariantT [Q.tc (.Seq [.Arg (Q.t (Q.varT "typeIR" [])), .Arg (Q.t
          (Q.varT "id" [])), .Atom (Q.a (.Operator ";"))]) "fieldTypeIR" []])).it) := by
      rw [nameEq]; rfl
    cases Option.some.inj (declared.symm.trans actual)
    change constructor ∈ [Q.tc (.Seq [.Arg (Q.t (Q.varT "typeIR" [])), .Arg (Q.t (Q.varT "id"
      [])), .Atom (Q.a (.Operator ";"))]) "fieldTypeIR" []] at member
    simp only [List.mem_cons, List.not_mem_nil, or_false] at member
    rcases member with rfl
    · have originalArgs : P4SpecTec.Domain.Mixfix.args ((.Seq [.Arg (Q.t (Q.varT "typeIR" [])),
        .Arg (Q.t (Q.varT
        "id" [])), .Atom (Q.a (.Operator ";"))]) : P4SpecTec.Domain.Mixfix.t
          P4SpecTec.Lang.Il.typ) = [Q.t (Q.varT "typeIR" []),
        Q.t (Q.varT "id" [])] := by
        simp only [P4SpecTec.Domain.Mixfix.args, List.flatMap_cons, List.flatMap_nil] <;> rfl
      obtain ⟨_arity, substitutions⟩ := fields
      dsimp only [Q.tc, P4SpecTec.Lang.Il.typcase.nottyp, Q.nt, Util.Source.mkPhrase]
        at substitutions
      rw [originalArgs] at substitutions
      cases substitutions with
      | cons sub0 rest0 =>
        cases rest0 with
        | cons sub1 rest1 =>
          cases rest1
          generalize argsShape : P4SpecTec.Domain.Mixfix.args tree = raws at ih
          cases ih with
          | @cons t0 a0 ts0 raws0 ih0 tail0 =>
            cases tail0 with
            | @cons t1 a1 ts1 raws1 ih1 tail1 =>
              cases tail1
              have matching : P4SpecTec.Domain.Mixfix.eq_mixop tree (((.Seq [(.Arg ()), (.Arg
                ()), (.Atom
                (Prelude.Value.atom (.Operator ";")))])) : P4SpecTec.Domain.Mixfix.mixop) = true
                  :=
                Representation.Source.mixopTrans tree _ _ mixopMatches (by rfl)
              exact soundBranch1_0 v tree a0 a1 shape matching argsShape (ih0 .f4 (matchField1_0
