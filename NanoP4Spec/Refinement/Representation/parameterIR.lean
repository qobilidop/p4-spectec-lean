  | .f1, x => AdmittedF1 x
  | .f2, x => AdmittedF2 x
  | .f3, x => AdmittedF3 x
  | .f4, x => AdmittedF4 x
  | .f5, x => (fun _ => True) x
  | .f6, x => (fun _ => True) x
  | .f7, x => (fun _ => True) x
  | .f8, x => (fun _ => True) x
