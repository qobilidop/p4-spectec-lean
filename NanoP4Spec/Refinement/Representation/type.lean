      generalize hargs : Domain.Mixfix.args tree = args at valid
      cases valid with
      | cons _ v0 _ _ p0 tail =>
        cases tail
        obtain ⟨x0, b0, h0⟩ :=
          (@Representation.DecoderCorrect.sufficient (ByteText) ⟨@ToValue.toValue ByteText
            P4SpecTec.Prelude.instToValueByteText⟩ (Representation.Source.Valid NanoP4Spec.spec
            Representation.Source.externDomain (Q.t .TextT).it) (fun _ : ByteText => True)
            (@OfValue.ofValue ByteText P4SpecTec.Prelude.instOfValueByteText)
            (@Representation.Codec.decoder (ByteText) ⟨@ToValue.toValue ByteText
            P4SpecTec.Prelude.instToValueByteText⟩ ⟨@OfValue.ofValue ByteText
            P4SpecTec.Prelude.instOfValueByteText⟩ (Representation.Source.Valid NanoP4Spec.spec
            Representation.Source.externDomain (Q.t .TextT).it) (fun _ : ByteText => True)
            (type.fieldCodec4_0))) v0 p0
        refine ⟨(NanoP4Spec.type._TID x0), (max b0 (0)) + 1, ?_⟩
        intro fuel large
        cases fuel with
        | zero => omega
        | succ fuel =>
          have enough0 : b0 ≤ fuel := by omega
          change NanoP4Spec.type.ofValue (fuel + 1) v = _
          rw [type.decode4 fuel v tree v0 shape (Representation.Source.mixopTrans tree _ _
            matching rfl) hargs]
          rw [h0 fuel enough0]
          all_goals rfl


/-- Every carrier value is admitted under the stated child totals. -/
theorem type.admittedAll : ∀ x : NanoP4Spec.type, (NanoP4Spec.type.admitted) x := by
  intro x
  cases x with
  | BIT_langle_rangle x0 =>
    exact ⟨((show ∀ x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x0, trivial⟩
  | INT_langle_rangle x0 =>
    exact ⟨((show ∀ x : (Int), (fun _ : Int => True) x from (fun _ => True.intro))) x0, trivial⟩
  | BOOL =>
    trivial
  | MATCH_KIND =>
    trivial
  | _TID x0 =>
    exact ⟨((show ∀ x : (ByteText), (fun _ : ByteText => True) x from (fun _ => True.intro)))
      x0, trivial⟩


